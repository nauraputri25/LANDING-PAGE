    <!-- SCRIPT 4 CHARTS INTERAKTIF -->
    <script>
        // 1. BAR CHART: LAPORAN PER UNIT (#074173 ke #1679AB)
        const ctxBar = document.getElementById('unitBarChart').getContext('2d');
        const barGrad = ctxBar.createLinearGradient(0, 0, 0, 180);
        barGrad.addColorStop(0, '#074173');
        barGrad.addColorStop(1, '#1679AB');

        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: ['TK', 'SD', 'SMP', 'SMA', 'Umum/HO'],
                datasets: [{
                    label: 'Jumlah Keluhan',
                    data: [12, 45, 28, 32, 18],
                    backgroundColor: barGrad,
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10 } } },
                    y: { grid: { color: '#e2e8f0' }, ticks: { color: '#64748b', font: { size: 10 } }, beginAtZero: true }
                }
            }
        });

        // 2. LINE CHART: TREN LAPORAN BULANAN (#1679AB dengan fill #5DEBD7)
        const ctxLine = document.getElementById('trendLineChart').getContext('2d');
        const lineGrad = ctxLine.createLinearGradient(0, 0, 0, 180);
        lineGrad.addColorStop(0, 'rgba(93, 235, 215, 0.45)');
        lineGrad.addColorStop(1, 'rgba(93, 235, 215, 0.0)');

        new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun'],
                datasets: [{
                    label: 'Tren Laporan',
                    data: [15, 22, 18, 35, 25, 12],
                    borderColor: '#1679AB',
                    borderWidth: 3,
                    backgroundColor: lineGrad,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#074173',
                    pointBorderColor: '#5DEBD7',
                    pointBorderWidth: 2,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10 } } },
                    y: { grid: { color: '#e2e8f0' }, ticks: { color: '#64748b', font: { size: 10 } }, beginAtZero: true }
                }
            }
        });

        // 3. DOUGHNUT CHART: KATEGORI PROBLEM IT (Wi-Fi, Proyektor, Laptop/PC, Printer)
        const ctxProblem = document.getElementById('problemCategoryChart').getContext('2d');
        new Chart(ctxProblem, {
            type: 'doughnut',
            data: {
                labels: ['Wi-Fi / Internet', 'Laptop / PC', 'Proyektor', 'Printer'],
                datasets: [{
                    data: [40, 30, 18, 12],
                    backgroundColor: ['#074173', '#1679AB', '#5DEBD7', '#C5FF95'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '72%',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // 4. STATUS BREAKDOWN (Pending #f59e0b, Dalam Proses #5DEBD7, Selesai #C5FF95)
        const ctxStatus = document.getElementById('statusBreakdownChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: ['Pending', 'Dalam Proses', 'Selesai'],
                datasets: [{
                    data: [8, 15, 101],
                    backgroundColor: ['#f59e0b', '#5DEBD7', '#C5FF95'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '72%',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // Scroll reveal & animations
        const revealEls = document.querySelectorAll('.team-card, .card-box, .ticket-box-full, .cta-box');
        revealEls.forEach(el => el.classList.add('anim-reveal'));
        const observer = new IntersectionObserver(entries => {
            entries.forEach((e, i) => {
                if (e.isIntersecting) {
                    setTimeout(() => e.target.classList.add('visible'), i * 100);
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.1 });
        revealEls.forEach(el => observer.observe(el));

        const ticketObserver = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    const items = e.target.querySelectorAll('.ticket-item');
                    items.forEach((item, i) => setTimeout(() => item.classList.add('visible'), i * 120));
                    ticketObserver.unobserve(e.target);
                }
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.ticket-list').forEach(el => ticketObserver.observe(el));

        // 🔌 ANIMASI KABEL LAN
        const cableCanvas = document.getElementById('heroCableCanvas');
        const cCtx = cableCanvas.getContext('2d');
        let lanCables = [];

        function resizeCableCanvas() {
            if(!cableCanvas) return;
            cableCanvas.width = cableCanvas.parentElement.offsetWidth;
            cableCanvas.height = cableCanvas.parentElement.offsetHeight;
            initCables();
        }

        function initCables() {
            lanCables = [];
            const cableCount = 12;
            const w = cableCanvas.width;
            const h = cableCanvas.height;
            for (let i = 0; i < cableCount; i++) {
                lanCables.push({
                    startX: Math.random() * w * 0.3 - 50,
                    startY: Math.random() * h,
                    cp1X: w * (0.2 + Math.random() * 0.3),
                    cp1Y: Math.random() * h,
                    cp2X: w * (0.5 + Math.random() * 0.3),
                    cp2Y: Math.random() * h,
                    endX: w * 0.8 + Math.random() * (w * 0.3),
                    endY: Math.random() * h,
                    progress: Math.random(),
                    speed: 0.003 + Math.random() * 0.004,
                    color: Math.random() > 0.4 ? '93, 235, 215' : '197, 255, 149',
                    width: Math.random() * 2 + 1.2
                });
            }
        }

        function getBezierPoint(t, p0, p1, p2, p3) {
            const cx = 3 * (p1 - p0);
            const bx = 3 * (p2 - p1) - cx;
            const ax = p3 - p0 - cx - bx;
            const cube = t * t * t;
            const square = t * t;
            return (ax * cube) + (bx * square) + (cx * t) + p0;
        }

        function drawLanCables() {
            cCtx.clearRect(0, 0, cableCanvas.width, cableCanvas.height);
            lanCables.forEach(c => {
                cCtx.beginPath();
                cCtx.moveTo(c.startX, c.startY);
                cCtx.bezierCurveTo(c.cp1X, c.cp1Y, c.cp2X, c.cp2Y, c.endX, c.endY);
                cCtx.strokeStyle = `rgba(${c.color}, 0.15)`;
                cCtx.lineWidth = c.width;
                cCtx.stroke();
                c.progress += c.speed;
                if (c.progress > 1) c.progress = 0;
                const currX = getBezierPoint(c.progress, c.startX, c.cp1X, c.cp2X, c.endX);
                const currY = getBezierPoint(c.progress, c.startY, c.cp1Y, c.cp2Y, c.endY);
                cCtx.beginPath();
                cCtx.arc(currX, currY, c.width * 2, 0, Math.PI * 2);
                cCtx.fillStyle = `rgba(${c.color}, 0.9)`;
                cCtx.shadowBlur = 12;
                cCtx.shadowColor = `rgba(${c.color}, 1)`;
                cCtx.fill();
                cCtx.shadowBlur = 0; 
            });
            requestAnimationFrame(drawLanCables);
        }

        window.addEventListener('resize', resizeCableCanvas);
        resizeCableCanvas();
        drawLanCables();
    </script>
</body>
</html>