<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IT Support & Services - Cendekia Muda</title>
    <!-- FontAwesome & Chart.js -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --bg-light: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --color-dark-blue: #074173;
            --color-ocean-blue: #1679AB;
            --color-cyan-mint: #5DEBD7;
            --color-lime-green: #C5FF95;
            --text-main: #074173;
            --text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            background-color: var(--bg-light);
            color: var(--text-main);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* 🚀 HEADER (DARK BLUE MODE) */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 50px;
            background: linear-gradient(90deg, rgba(7,65,115,0.96), rgba(8,96,144,0.98));
            border-bottom: 1px solid rgba(93, 235, 215, 0.18);
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.16);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-img {
            height: 32px;
            width: auto;
            display: block;
            object-fit: contain;
        }

        .logo-divider {
            width: 1px;
            height: 22px;
            background-color: rgba(255, 255, 255, 0.3);
        }

        .logo-sub {
            font-size: 17px;
            color: var(--color-cyan-mint);
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        nav a.active::after {
            content: "";
            position: absolute;
            bottom: -4px;
            left: 50%;
            transform: translateX(-50%);
            width: 48%;
            height: 3px;
            background: linear-gradient(90deg, var(--color-cyan-mint), #9cf2c7);
            border-radius: 2px;
        }

        nav a:hover, nav a.active {
            color: #ffffff;
        }

        nav a.active::after {
            content: "";
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--color-cyan-mint);
            border-radius: 2px;
        }

        /* 🌌 HERO BANNER */
        .hero {
            padding: 70px 20px 40px 20px;
            text-align: center;
            background: radial-gradient(circle at 50% 20%, rgba(93, 235, 215, 0.25) 0%, transparent 70%);
        }

        .hero h1 {
            font-size: 42px;
            font-weight: 900;
            margin: 0 0 8px 0;
            letter-spacing: 3px;
            color: var(--color-dark-blue);
        }

        .hero .subtitle {
            font-size: 24px;
            color: var(--color-ocean-blue);
            font-weight: 800;
            letter-spacing: 1.5px;
            margin-bottom: 14px;
        }

        .hero p {
            color: var(--text-muted);
            font-size: 14px;
            max-width: 620px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* 📦 MAIN CONTAINER */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 10px 24px 70px 24px;
            width: 100%;
        }

        .section-header {
            font-size: 15px;
            font-weight: 800;
            color: var(--color-dark-blue);
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        /* 👥 INTERACTIVE TEAM CARDS */
        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 24px;
            margin-bottom: 45px;
        }

        .team-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 22px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
            cursor: pointer;
        }

        .team-card:hover {
            transform: translateY(-8px) scale(1.01);
            border-color: var(--color-ocean-blue);
            box-shadow: 0 15px 30px rgba(22, 121, 171, 0.15);
        }

        .team-body {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 16px;
        }

        .avatar-wrapper {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, var(--color-ocean-blue), var(--color-cyan-mint));
            flex-shrink: 0;
        }

        .avatar-wrapper img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            background-color: #f1f5f9;
        }

        .team-info h3 {
            margin: 0;
            font-size: 17px;
            font-weight: 800;
            color: var(--color-dark-blue);
            letter-spacing: 0.5px;
        }

        .team-info .role-badge {
            display: inline-block;
            background: rgba(22, 121, 171, 0.1);
            color: var(--color-ocean-blue);
            font-size: 10px;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 6px;
            margin: 6px 0 8px 0;
            letter-spacing: 0.8px;
        }

        .contact-list {
            font-size: 11px;
            color: var(--text-muted);
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .btn-contact {
            background-color: #f1f5f9;
            border: 1px solid var(--border-color);
            color: var(--color-dark-blue);
            font-size: 12px;
            font-weight: 700;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            text-decoration: none;
        }

        .team-card:hover .btn-contact {
            background-color: var(--color-ocean-blue);
            color: #ffffff;
            border-color: var(--color-ocean-blue);
        }

        /* 📊 DASHBOARD GRID & INTERACTIVE CHART */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1.4fr;
            gap: 24px;
            margin-bottom: 50px;
        }

        .card-box {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 22px;
            padding: 26px;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
        }

        .card-box:hover {
            border-color: var(--color-ocean-blue);
            transform: translateY(-4px);
        }

        /* Donut Chart Container */
        .chart-wrapper {
            position: relative;
            width: 210px;
            height: 210px;
            margin: 0 auto;
        }

        .chart-center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
        }

        .chart-center-text .number {
            font-size: 26px;
            font-weight: 900;
            color: var(--color-dark-blue);
            line-height: 1;
        }

        .chart-center-text .label {
            font-size: 10px;
            color: var(--text-muted);
            letter-spacing: 1px;
            margin-top: 4px;
        }

        /* 🎟️ TICKET LIST */
        .ticket-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .ticket-item {
            background: #f8fafc;
            border: 1px solid var(--border-color);
            padding: 14px 18px;
            border-radius: 14px;
        }

        .ticket-item:hover {
            background: #ffffff;
            transform: translateX(6px);
            border-color: var(--color-ocean-blue);
            box-shadow: 0 4px 12px rgba(7, 65, 115, 0.08);
        }

        .ticket-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }

        .ticket-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--color-dark-blue);
        }

        .badge-priority {
            background: rgba(239, 68, 68, 0.15);
            color: #dc2626;
            font-size: 9px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            letter-spacing: 0.5px;
        }

        .badge-normal {
            background: rgba(22, 121, 171, 0.15);
            color: var(--color-ocean-blue);
            font-size: 9px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            letter-spacing: 0.5px;
        }

        .ticket-pic {
            font-size: 11px;
            color: var(--text-muted);
        }

        .progress-bar-bg {
            height: 7px;
            background-color: #e2e8f0;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 8px;
        }

        .progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--color-ocean-blue), var(--color-cyan-mint));
            border-radius: 10px;
        }

        /* 🔥 CALL TO ACTION BUTTON */
        .cta-box {
            text-align: center;
            margin-top: 20px;
        }

        .btn-submit-main {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: var(--color-dark-blue);
            color: #ffffff;
            font-weight: 800;
            font-size: 15px;
            letter-spacing: 1px;
            padding: 18px 42px;
            border-radius: 16px;
            text-decoration: none;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.25);
        }

        .btn-submit-main:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 15px 30px rgba(22, 121, 171, 0.35);
            background: var(--color-ocean-blue);
        }

        footer {
            background-color: #ffffff;
            padding: 24px;
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            border-top: 1px solid var(--border-color);
            margin-top: auto;
        }

        @media (max-width: 768px) {
            header { padding: 16px 20px; }
            .dashboard-grid { grid-template-columns: 1fr; }
        }

        /* ── ANIMATIONS ── */
        @keyframes fadeDown {
            from { opacity: 0; transform: translateY(-24px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(32px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeLeft {
            from { opacity: 0; transform: translateX(-24px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        @keyframes shimmer {
            0%   { background-position: -200% center; }
            100% { background-position: 200% center; }
        }
        @keyframes rotateBorder {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }
        @keyframes pulseShadow {
            0%, 100% { box-shadow: 0 10px 25px rgba(7,65,115,0.25); }
            50%       { box-shadow: 0 10px 35px rgba(93,235,215,0.45), 0 0 0 6px rgba(93,235,215,0.1); }
        }

        /* Hero entrance */
        .hero h1         { animation: fadeDown 0.7s 0.1s ease both; }
        .hero .subtitle  { animation: fadeDown 0.7s 0.25s ease both; }
        .hero p          { animation: fadeDown 0.7s 0.4s ease both; }

        /* Section header slide from left */
        .section-header  { animation: fadeLeft 0.6s 0.2s ease both; }

        /* Scroll reveal base — pakai wrapper animasi terpisah agar tidak bentrok dengan hover transform */
        .anim-reveal {
            animation: fadeUp 0.6s ease both;
            animation-play-state: paused;
        }
        .anim-reveal.visible {
            animation-play-state: running;
        }

        /* Avatar rotating gradient ring */
        .avatar-wrapper::before {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            background: conic-gradient(var(--color-cyan-mint), var(--color-lime-green), var(--color-ocean-blue), var(--color-cyan-mint));
            animation: rotateBorder 3s linear infinite;
            z-index: 0;
        }
        .avatar-wrapper img {
            position: relative;
            z-index: 1;
        }

        /* CTA button pulse */
        .btn-submit-main {
            animation: pulseShadow 2.5s ease-in-out infinite;
        }
        .btn-submit-main:hover {
            animation: none;
        }

        /* Ticket items stagger via JS */
        .ticket-item {
            animation: fadeLeft 0.5s ease both;
            animation-play-state: paused;
        }
        .ticket-item.visible {
            animation-play-state: running;
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header>
        <div class="logo-container">
            <img src="/images/logo-kcm.png" alt="Logo KCM" class="logo-img">
            <div class="logo-divider"></div>
            <div class="logo-sub">IT Support & General Affair</div>
        </div>

        <nav>
            <a href="/">Home</a>
            <a href="/it-support" class="active">IT Support</a>
            <a href="/ga">GA (General Affair)</a>
            <a href="/about">About Us</a>
        </nav>
    </header>

    <!-- HERO SECTION -->
    <div class="hero">
        <h1>BANTUAN TEKNIS</h1>
        <div class="subtitle">CENDEKIA MUDA</div>
        <p>Siap mengatasi kendala IT dengan cepat, amanah, dan profesional.</p>
    </div>

    <main class="container">

        <!-- SECTION TIM IT SUPPORT -->
        <div class="section-header">
            <i class="fa-solid fa-users-gear" style="color: var(--color-ocean-blue);"></i> TIM IT SUPPORT / PIC
        </div>

        <div class="team-grid">
            <!-- PIC 1 -->
            <div class="team-card">
                <div class="team-body">
                    <div class="avatar-wrapper">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" alt="Harisma Permana">
                    </div>
                    <div class="team-info">
                        <h3>HARISMA PERMANA</h3>
                        <div class="role-badge">TIM IT SUPPORT</div>
                        <div class="contact-list">
                            <span><i class="fa-solid fa-phone" style="width: 14px;"></i> Ext: 102</span>
                            <span><i class="fa-brands fa-whatsapp" style="width: 14px;"></i> WA: 0812-xxxx-xxxx</span>
                        </div>
                    </div>
                </div>
                <a href="https://wa.me/" target="_blank" class="btn-contact">Hubungi PIC</a>
            </div>

            <!-- PIC 2 -->
            <div class="team-card">
                <div class="team-body">
                    <div class="avatar-wrapper">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80" alt="Budi Santoso">
                    </div>
                    <div class="team-info">
                        <h3>BUDI SANTOSO</h3>
                        <div class="role-badge">SPESIALIS HARDWARE & PC</div>
                        <div class="contact-list">
                            <span><i class="fa-solid fa-phone" style="width: 14px;"></i> Ext: 103</span>
                            <span><i class="fa-brands fa-whatsapp" style="width: 14px;"></i> WA: 0813-xxxx-xxxx</span>
                        </div>
                    </div>
                </div>
                <a href="https://wa.me/" target="_blank" class="btn-contact">Hubungi PIC</a>
            </div>
        </div>

        <!-- SECTION DASHBOARD & TICKETS -->
        <div class="dashboard-grid">
            
            <!-- Donut Chart Card -->
            <div class="card-box">
                <div class="section-header" style="font-size: 13px; margin-bottom: 16px;">
                    <i class="fa-solid fa-chart-pie" style="color: var(--color-ocean-blue);"></i> KATEGORI KERUSAKAN IT
                </div>
                <div class="chart-wrapper">
                    <canvas id="damageChart"></canvas>
                    <div class="chart-center-text">
                        <div class="number">124</div>
                        <div class="label">TIKET/BLN</div>
                    </div>
                </div>
            </div>

            <!-- Tiket Berjalan -->
            <div class="card-box">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <div class="section-header" style="font-size: 13px; margin: 0;">
                        <i class="fa-solid fa-list-check" style="color: var(--color-ocean-blue);"></i> TIKET IT AKTIF
                    </div>
                    <span style="font-size: 11px; color: var(--color-ocean-blue); font-weight: 700;">4 Tiket Berjalan</span>
                </div>

                <div class="ticket-list">
                    <div class="ticket-item">
                        <div class="ticket-top">
                            <span class="ticket-title">Troubleshoot Server Lantai 3</span>
                            <span class="badge-priority">PRIORITY</span>
                        </div>
                        <span class="ticket-pic"><i class="fa-solid fa-user-gear"></i> PIC: Harisma Permana</span>
