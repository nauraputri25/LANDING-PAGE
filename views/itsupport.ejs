            <a href="https://wa.me/" target="_blank" class="btn-contact">Hubungi</a>
        </div>

    </div> 
</main>

        <!-- SECTION DATA TABEL DARI GOOGLE SHEET DENGAN PAGINASI -->
        <div class="section-header">
            <i class="fa-solid fa-table" style="color: var(--color-ocean-blue);"></i> LAPORAN MAINTENANCE (REAL-TIME GOOGLE SHEET)
        </div>
        <div class="table-box-full">
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Waktu/Tanggal</th>
                            <th>Unit</th>
                            <th>Nama Request</th>
                            <th>Permasalahan</th>
                            <th>Detail Permasalahan</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="tableReportBody">
                        <!-- Content rendered via Client-Side Script to support Page Pagination (Max 10) -->
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION BAR -->
            <div class="pagination-bar">
                <div class="pagination-info" id="paginationInfo">Showing 0 of 0 reports</div>
                <div class="pagination-btn-group">
                    <button class="pg-btn" id="prevBtn" onclick="changePage(-1)"><i class="fa-solid fa-chevron-left"></i></button>
                    <button class="pg-btn" id="nextBtn" onclick="changePage(1)"><i class="fa-solid fa-chevron-right"></i></button>
