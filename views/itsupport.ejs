<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IT Support & Services - Cendekia Muda</title>
    <!-- FontAwesome & Chart.js -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --bg-dark: #090d16;
            --card-bg: #111827;
            --border-color: rgba(255, 255, 255, 0.08);
            --pink-accent: #f472b6;
            --pink-glow: rgba(244, 114, 182, 0.4);
            --purple-accent: #a855f7;
            --cyan-accent: #22d3ee;
            --text-main: #ffffff;
            --text-muted: #9ca3af;
        }

        * {
            box-sizing: border-box;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* 🚀 HEADER PERSIS FOTO ACUAN */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 50px;
            background: rgba(9, 13, 22, 0.85);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-kcm {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #38bdf8 0%, #4ade80 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .logo-divider {
            width: 1px;
            height: 22px;
            background-color: rgba(255, 255, 255, 0.2);
        }

        .logo-sub {
            font-size: 11px;
            color: #d1d5db;
            letter-spacing: 2px;
            font-weight: 600;
            text-transform: uppercase;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        nav a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.5px;
            position: relative;
            padding: 4px 0;
        }

        nav a:hover, nav a.active {
            color: #ffffff;
        }

        nav a.active::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, var(--cyan-accent), var(--pink-accent));
            border-radius: 2px;
        }

        .search-icon {
            color: var(--text-muted);
            cursor: pointer;
            font-size: 14px;
            margin-left: 10px;
        }
        .search-icon:hover { color: #ffffff; }

        /* 🌌 HERO BANNER */
        .hero {
            padding: 70px 20px 40px 20px;
            text-align: center;
            background: radial-gradient(circle at 50% 20%, rgba(168, 85, 247, 0.18) 0%, transparent 60%);
        }

        .hero h1 {
            font-size: 42px;
            font-weight: 900;
            margin: 0 0 8px 0;
            letter-spacing: 3px;
            text-shadow: 0 0 20px rgba(255,255,255,0.2);
        }

        .hero .subtitle {
            font-size: 24px;
            background: linear-gradient(90deg, var(--pink-accent), var(--purple-accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
            letter-spacing: 1.5px;
            margin-bottom: 14px;
        }

        .hero p {
            color: var(--text-muted);
            font-size: 14px;
            max-width: 620px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* 📦 MAIN CONTAINER */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 10px 24px 70px 24px;
            width: 100%;
        }

        .section-header {
            font-size: 15px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        /* 👥 INTERACTIVE TEAM CARDS */
        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 24px;
            margin-bottom: 45px;
        }

        .team-card {
            background: linear-gradient(145deg, #131c2e 0%, #0d1322 100%);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 22px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            cursor: pointer;
        }

        /* Hover Effect Timbul & Glow */
        .team-card:hover {
            transform: translateY(-8px) scale(1.02);
            border-color: var(--pink-accent);
            box-shadow: 0 15px 35px rgba(244, 114, 182, 0.25);
        }

        .team-card::after {
            content: "";
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, var(--pink-glow) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .team-card:hover::after {
            opacity: 1;
        }

        .team-body {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 16px;
        }

        .avatar-wrapper {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, var(--cyan-accent), var(--pink-accent));
            flex-shrink: 0;
        }

        .avatar-wrapper img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            background-color: #1f293d;
        }

        .team-info h3 {
            margin: 0;
            font-size: 17px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0.5px;
        }

        .team-info .role-badge {
            display: inline-block;
            background: rgba(244, 114, 182, 0.15);
            color: var(--pink-accent);
            font-size: 10px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 6px;
            margin: 6px 0 8px 0;
            letter-spacing: 0.8px;
        }

        .contact-list {
            font-size: 11px;
            color: var(--text-muted);
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .btn-contact {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: #ffffff;
            font-size: 12px;
            font-weight: 700;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            text-decoration: none;
        }

        .team-card:hover .btn-contact {
            background-color: var(--pink-accent);
            color: #000000;
            border-color: var(--pink-accent);
            box-shadow: 0 4px 15px var(--pink-glow);
        }

        /* 📊 DASHBOARD GRID & INTERACTIVE CHART */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1.4fr;
            gap: 24px;
            margin-bottom: 50px;
        }

        .card-box {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 22px;
            padding: 26px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .card-box:hover {
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-4px);
        }

        /* Donut Chart Container */
        .chart-wrapper {
            position: relative;
            width: 210px;
            height: 210px;
            margin: 0 auto;
        }

        .chart-center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
        }

        .chart-center-text .number {
            font-size: 26px;
            font-weight: 900;
            color: #ffffff;
            line-height: 1;
        }

        .chart-center-text .label {
            font-size: 10px;
            color: var(--text-muted);
            letter-spacing: 1px;
            margin-top: 4px;
        }

        /* 🎟️ TICKET LIST */
        .ticket-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .ticket-item {
            background: #162032;
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 14px 18px;
            border-radius: 14px;
        }

        .ticket-item:hover {
            background: #1c2942;
            transform: translateX(6px);
            border-color: var(--purple-accent);
        }

        .ticket-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }

        .ticket-title {
            font-size: 13px;
            font-weight: 700;
            color: #ffffff;
        }

        .badge-priority {
            background: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
            font-size: 9px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            letter-spacing: 0.5px;
        }

        .badge-normal {
            background: rgba(59, 130, 246, 0.2);
            color: #93c5fd;
            font-size: 9px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            letter-spacing: 0.5px;
        }

        .ticket-pic {
            font-size: 11px;
            color: var(--text-muted);
        }

        .progress-bar-bg {
            height: 7px;
            background-color: #27354d;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 8px;
        }

        .progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--purple-accent), var(--pink-accent));
            border-radius: 10px;
        }

        /* 🔥 CALL TO ACTION BUTTON */
        .cta-box {
            text-align: center;
            margin-top: 20px;
        }

        .btn-submit-main {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: linear-gradient(135deg, #fbcfe8 0%, #f472b6 100%);
            color: #0f172a;
            font-weight: 900;
            font-size: 15px;
            letter-spacing: 1px;
            padding: 18px 42px;
            border-radius: 16px;
            text-decoration: none;
            box-shadow: 0 10px 30px rgba(244, 114, 182, 0.35);
        }

        .btn-submit-main:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 15px 40px rgba(244, 114, 182, 0.5);
            background: linear-gradient(135deg, #ffffff 0%, #f472b6 100%);
        }

        footer {
            background-color: #05080f;
            padding: 24px;
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            border-top: 1px solid var(--border-color);
            margin-top: auto;
        }

        @media (max-width: 768px) {
            header { padding: 16px 20px; }
            .dashboard-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <!-- 📌 HEADER SANGAT MIRIP FOTO ACUAN -->
    <header>
        <div class="logo-container">
            <div class="logo-kcm">
                <i class="fa-solid fa-shapes" style="font-size: 20px;"></i> KCM
            </div>
            <div class="logo-divider"></div>
            <div class="logo-sub">LAYANAN & MAINTANANCE</div>
        </div>

        <nav>
            <a href="/">Home</a>
            <a href="/it-support" class="active">IT Support</a>
            <a href="/ga">GA (General Affair)</a>
            <a href="/about">About Us</a>
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
        </nav>
    </header>

    <!-- 🌌 HERO SECTION -->
    <div class="hero">
        <h1>BANTUAN TEKNIS</h1>
        <div class="subtitle">CENDEKIA MUDA</div>
        <p>Siap mengatasi kendala IT dengan cepat, amanah, dan profesional.</p>
    </div>

    <main class="container">

        <!-- 👥 SECTION TIM IT SUPPORT -->
        <div class="section-header">
            <i class="fa-solid fa-users-gear" style="color: var(--pink-accent);"></i> TIM IT SUPPORT / PIC
        </div>

        <div class="team-grid">
            <!-- PIC 1 -->
            <div class="team-card">
                <div class="team-body">
                    <div class="avatar-wrapper">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" alt="Harisma Permana">
                    </div>
                    <div class="team-info">
                        <h3>HARISMA PERMANA</h3>
                        <div class="role-badge">TIM IT SUPPORT</div>
                        <div class="contact-list">
                            <span><i class="fa-solid fa-phone" style="width: 14px;"></i> Ext: 102</span>
                            <span><i class="fa-brands fa-whatsapp" style="width: 14px;"></i> WA: 0812-xxxx-xxxx</span>
                        </div>
                    </div>
                </div>
                <a href="https://wa.me/" target="_blank" class="btn-contact">Hubungi PIC</a>
            </div>

            <!-- PIC 2 -->
            <div class="team-card">
                <div class="team-body">
                    <div class="avatar-wrapper">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80" alt="Budi Santoso">
                    </div>
                    <div class="team-info">
                        <h3>BUDI SANTOSO</h3>
                        <div class="role-badge">SPESIALIS HARDWARE & PC</div>
                        <div class="contact-list">
                            <span><i class="fa-solid fa-phone" style="width: 14px;"></i> Ext: 103</span>
                            <span><i class="fa-brands fa-whatsapp" style="width: 14px;"></i> WA: 0813-xxxx-xxxx</span>
                        </div>
                    </div>
                </div>
                <a href="https://wa.me/" target="_blank" class="btn-contact">Hubungi PIC</a>
            </div>
        </div>

        <!-- 📊 SECTION DASHBOARD & TICKETS -->
        <div class="dashboard-grid">
            
            <!-- Donut Chart Card -->
            <div class="card-box">
                <div class="section-header" style="font-size: 13px; margin-bottom: 16px;">
                    <i class="fa-solid fa-chart-pie" style="color: var(--cyan-accent);"></i> KATEGORI KERUSAKAN IT
                </div>
                <div class="chart-wrapper">
                    <canvas id="damageChart"></canvas>
                    <div class="chart-center-text">
                        <div class="number">124</div>
                        <div class="label">TIKET/BLN</div>
                    </div>
                </div>
            </div>

            <!-- Tiket Berjalan -->
            <div class="card-box">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <div class="section-header" style="font-size: 13px; margin: 0;">
                        <i class="fa-solid fa-list-check" style="color: var(--purple-accent);"></i> TIKET IT AKTIF
                    </div>
                    <span style="font-size: 11px; color: var(--pink-accent); font-weight: 700;">4 Tiket Berjalan</span>
                </div>

                <div class="ticket-list">
                    <div class="ticket-item">
                        <div class="ticket-top">
                            <span class="ticket-title">Troubleshoot Server Lantai 3</span>
                            <span class="badge-priority">PRIORITY</span>
                        </div>
                        <span class="ticket-pic"><i class="fa-solid fa-user-gear"></i> PIC: Harisma Permana</span>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" style="width: 75%;"></div></div>
                    </div>

                    <div class="ticket-item">
                        <div class="ticket-top">
                            <span class="ticket-title">Instalasi PC Baru HRD</span>
                            <span class="badge-normal">NORMAL</span>
                        </div>
                        <span class="ticket-pic"><i class="fa-solid fa-user-gear"></i> PIC: Budi Santoso</span>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" style="width: 30%;"></div></div>
                    </div>

                    <div class="ticket-item">
                        <div class="ticket-top">
                            <span class="ticket-title">Optimalisasi Wi-Fi Area Lapangan</span>
                            <span class="badge-priority">PRIORITY</span>
                        </div>
                        <span class="ticket-pic"><i class="fa-solid fa-user-gear"></i> PIC: Harisma Permana</span>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" style="width: 15%;"></div></div>
                    </div>
                </div>
            </div>

        </div>

        <!-- 🔥 TOMBOL ACTION KE FORM -->
        <div class="cta-box">
            <a href="/it-support/form" class="btn-submit-main">
                <span>AJUKAN PERBAIKAN IT</span>
                <i class="fa-solid fa-arrow-right-long"></i>
            </a>
        </div>

    </main>

    <footer>
        <p>© 2024 PORTAL MAINTENANCE INTERNAL - CENDEKIA MUDA. All rights reserved.</p>
    </footer>

    <!-- 📈 SCRIPT CHART.JS INTERAKTIF -->
    <script>
        const ctx = document.getElementById('damageChart').getContext('2d');
        
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Hardware & Laptop', 'Jaringan Wi-Fi', 'Software / Aplikasi'],
                datasets: [{
                    data: [45, 35, 20],
                    backgroundColor: [
                        '#f472b6', // Pink
                        '#a855f7', // Purple
                        '#38bdf8'  // Cyan
                    ],
                    borderWidth: 0,
                    hoverOffset: 12 // Efek pop-up pas dikursorin
                }]
            },
            options: {
                cutout: '72%',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false // Sembunyikan legenda agar rapi di chart
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleColor: '#ffffff',
                        bodyColor: '#f472b6',
                        borderColor: 'rgba(255,255,255,0.1)',
                        borderWidth: 1,
                        padding: 12,
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                return ` ${context.label}: ${context.raw}%`;
                            }
                        }g
                    }
                }
            }
        });
    </script>
</body>
</html>