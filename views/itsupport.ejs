                <i class="fa-solid fa-arrow-right-long"></i>
            </a>
        </div>

    </main>

    <footer>
        <p>© 2026 PORTAL MAINTENANCE INTERNAL - CENDEKIA MUDA. All rights reserved.</p>
    </footer>

    <!-- SCRIPT CHART.JS INTERAKTIF -->
    <script>
        const ctx = document.getElementById('damageChart').getContext('2d');
        
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Hardware & Laptop', 'Jaringan Wi-Fi', 'Software / Aplikasi'],
                datasets: [{
                    data: [45, 35, 20],
                    backgroundColor: [
                        '#074173', // Dark Blue
                        '#1679AB', // Ocean Blue
                        '#5DEBD7'  // Cyan Mint
                    ],
                    borderWidth: 0,
                    hoverOffset: 12
                }]
            },
            options: {
                cutout: '72%',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: '#074173',
                        titleColor: '#ffffff',
                        bodyColor: '#5DEBD7',
                        borderColor: '#e2e8f0',
                        borderWidth: 1,
                        padding: 12,
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                return ` ${context.label}: ${context.raw}%`;
                            }
                        }
                    }
                }
            }
        });

        // Scroll reveal — cards, card-box, cta
        const revealEls = document.querySelectorAll('.team-card, .card-box, .cta-box');
        revealEls.forEach(el => el.classList.add('anim-reveal'));

        const observer = new IntersectionObserver(entries => {
            entries.forEach((e, i) => {
                if (e.isIntersecting) {
                    setTimeout(() => e.target.classList.add('visible'), i * 120);
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.12 });
        revealEls.forEach(el => observer.observe(el));

        // Ticket items stagger
        const ticketObserver = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    const items = e.target.querySelectorAll('.ticket-item');
                    items.forEach((item, i) => setTimeout(() => item.classList.add('visible'), i * 150));
                    ticketObserver.unobserve(e.target);
                }
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.ticket-list').forEach(el => ticketObserver.observe(el));
    </script>
</body>
</html>