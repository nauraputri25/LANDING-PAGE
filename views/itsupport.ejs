<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IT Support & Services - Cendekia Muda</title>
    <!-- FontAwesome & Chart.js -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --bg-light: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --color-dark-blue: #074173;
            --color-ocean-blue: #1679AB;
            --color-cyan-mint: #5DEBD7;
            --color-lime-green: #C5FF95;
            --text-main: #074173;
            --text-muted: #64748b;
        }
        * {
            box-sizing: border-box;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        body {
            background-color: var(--bg-light);
            color: var(--text-main);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }
        /* 🚀 HEADER */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 50px;
            background-color: var(--color-dark-blue);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }
        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .logo-img {
            height: 32px;
            width: auto;
            display: block;
            object-fit: contain;
        }
        .logo-divider {
            width: 1px;
            height: 22px;
            background-color: rgba(255, 255, 255, 0.3);
        }
        .logo-sub {
            font-size: 17px;
            color: var(--color-cyan-mint);
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
        }
        nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }
        nav a {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.5px;
            position: relative;
            padding: 4px 0;
        }
        nav a:hover, nav a.active {
            color: #ffffff;
        }
        nav a.active::after {
            content: "";
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--color-cyan-mint);
            border-radius: 2px;
        }
        /* 🌌 HERO BANNER */
        .hero {
            position: relative;
            width: 100%;
            padding: 130px 20px 170px 20px;
            min-height: 520px;
            text-align: center;
            overflow: hidden;
            background: 
                linear-gradient(180deg, rgba(4, 22, 45, 0.92) 0%, rgba(7, 45, 80, 0.88) 60%, rgba(4, 22, 45, 0.96) 100%),
                url('https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=1600&q=80') center/cover no-repeat;
        }
        .hero canvas#heroCableCanvas {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 1;
        }
        .hero-grid {
            position: absolute; inset: 0; pointer-events: none; z-index: 1;
            background-image: 
                linear-gradient(rgba(93,235,215,0.04) 1px, transparent 1px), 
                linear-gradient(90deg, rgba(93,235,215,0.04) 1px, transparent 1px);
            background-size: 40px 40px;
        }
        .hero-inner { 
            position: relative; 
            z-index: 2; 
            max-width: 820px; 
            margin: 0 auto; 
        }
        .hero-badge {
            display: inline-flex; align-items: center; gap: 8px;
            background: rgba(93,235,215,0.08);
            border: 1px solid rgba(93,235,215,0.3);
            color: var(--color-cyan-mint);
            font-size: 0.78rem; font-weight: 700;
            letter-spacing: 0.12em; text-transform: uppercase;
            padding: 8px 20px; border-radius: 999px;
            margin-bottom: 24px;
            box-shadow: 0 0 15px rgba(93, 235, 215, 0.15);
            backdrop-filter: blur(8px);
        }
        .hero-badge-dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: var(--color-cyan-mint);
            box-shadow: 0 0 10px var(--color-cyan-mint);
            animation: dotBlink 1.5s ease-in-out infinite;
        }
        .hero h1 {
            font-size: clamp(2.4rem, 5.5vw, 4rem);
            font-weight: 900;
            margin: 0 0 10px 0;
            letter-spacing: -0.02em;
            line-height: 1.1;
            background: linear-gradient(135deg, #ffffff 0%, #d0eaf8 60%, #90d0f5 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .hero .subtitle {
            font-size: clamp(1.4rem, 3.2vw, 2.5rem);
            background: linear-gradient(135deg, var(--color-cyan-mint) 0%, #82f3e5 50%, var(--color-lime-green) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            font-weight: 900;
            letter-spacing: 1.5px;
            margin-bottom: 20px;
            filter: drop-shadow(0 0 18px rgba(93,235,215,0.35));
        }
        .hero p {
            color: rgba(255,255,255,0.82);
            font-size: 0.98rem;
            max-width: 640px;
            margin: 0 auto;
            line-height: 1.7;
        }
        .hero-stats-wrapper {
            position: relative;
            z-index: 10;
            max-width: 800px;
            margin: -60px auto 40px auto; 
            padding: 0 20px;
            width: 100%;
        }       
        .hero-stats {
            display: flex; 
            justify-content: space-around;
            align-items: center;
            background: rgba(6, 28, 54, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(93, 235, 215, 0.25);
            border-radius: 16px;
            padding: 24px 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(93, 235, 215, 0.1);
        }
        .stat-item {
            flex: 1; text-align: center;
            padding: 0 15px;
            position: relative;
        }
        .stat-item:not(:last-child)::after {
            content: '';
            position: absolute;
            right: 0; top: 15%; bottom: 15%;
            width: 1px;
            background: linear-gradient(to bottom, transparent, rgba(93, 235, 215, 0.3), transparent);
        }
        .stat-num {
            font-size: clamp(1.6rem, 2.5vw, 2.2rem); 
            font-weight: 900; 
            line-height: 1;
            background: linear-gradient(135deg, #ffffff 20%, var(--color-cyan-mint) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .stat-label { 
            font-size: 0.72rem; 
            color: rgba(255,255,255,0.65); 
            text-transform: uppercase; 
            letter-spacing: 0.12em; 
            margin-top: 8px; 
            font-weight: 600;
        }
        /* 📦 MAIN CONTAINER */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 10px 24px 70px 24px;
            width: 100%;
        }
        .section-header {
            font-size: 15px;
            font-weight: 800;
            color: var(--color-dark-blue);
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 24px;
            margin-bottom: 45px;
        }
        .team-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 22px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
            cursor: pointer;
        }
        .team-card:hover {
            transform: translateY(-8px) scale(1.01);
            border-color: var(--color-ocean-blue);
            box-shadow: 0 15px 30px rgba(22, 121, 171, 0.15);
        }
        .team-body {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 16px;
        }
        .avatar-wrapper {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, var(--color-ocean-blue), var(--color-cyan-mint));
            flex-shrink: 0;
        }
        .avatar-wrapper img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            background-color: #f1f5f9;
        }
        .team-info h3 {
            margin: 0;
            font-size: 17px;
            font-weight: 800;
            color: var(--color-dark-blue);
            letter-spacing: 0.5px;
        }
        .team-info .role-badge {
            display: inline-block;
            background: rgba(22, 121, 171, 0.1);
            color: var(--color-ocean-blue);
            font-size: 10px;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 6px;
            margin: 6px 0 8px 0;
            letter-spacing: 0.8px;
        }
        .contact-list {
            font-size: 11px;
            color: var(--text-muted);
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .btn-contact {
            background-color: #f1f5f9;
            border: 1px solid var(--border-color);
            color: var(--color-dark-blue);
            font-size: 12px;
            font-weight: 700;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            text-decoration: none;
        }
        .team-card:hover .btn-contact {
            background-color: var(--color-ocean-blue);
            color: #ffffff;
            border-color: var(--color-ocean-blue);
        }
        
        /* 📊 DASHBOARD GRID & CHARTS */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-bottom: 35px;
        }
        .card-box {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 22px;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .card-box:hover {
            border-color: var(--color-ocean-blue);
            transform: translateY(-4px);
        }
        .chart-container-box {
            position: relative;
            height: 180px;
            width: 100%;
        }
        .chart-center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
        }
        .chart-center-text .number {
            font-size: 22px;
            font-weight: 900;
            color: var(--color-dark-blue);
            line-height: 1;
        }
        .chart-center-text .label {
            font-size: 9px;
            color: var(--text-muted);
            letter-spacing: 0.8px;
            margin-top: 3px;
        }

        /* 🏷️ CHART LEGEND KUSTOM DI BAWAH CHART */
        .chart-legend-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin-top: 14px;
            padding-top: 10px;
            border-top: 1px dashed var(--border-color);
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
        }
        .legend-color-box {
            width: 10px;
            height: 10px;
            border-radius: 3px;
        }

        /* 📋 TABLE STYLING */
        .table-box-full {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 22px;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
            margin-bottom: 40px;
        }
        .table-responsive {
            overflow-x: auto;
        }
        .custom-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 13px;
        }
        .custom-table th {
            background-color: #f1f5f9;
            color: var(--color-dark-blue);
            font-weight: 700;
            padding: 12px 14px;
            border-bottom: 2px solid var(--border-color);
            white-space: nowrap;
        }
        .custom-table td {
            padding: 12px 14px;
            border-bottom: 1px solid var(--border-color);
            color: #334155;
            vertical-align: middle;
        }
        .custom-table tr:last-child td {
            border-bottom: none;
        }
        .custom-table tr:hover td {
            background-color: #f8fafc;
        }

        /* 🎨 STYLED STATUS BADGES (MATCHING GOOGLE SHEET DROPDOWN) */
        .badge-status {
            font-weight: 700;
            font-size: 11px;
            padding: 5px 12px;
            border-radius: 12px;
            display: inline-block;
            text-align: center;
        }
        .badge-acc {
            background-color: #CBD5E1;
            color: #475569;
        }
        .badge-proses {
            background-color: #FEF08A;
            color: #854d0e;
        }
        .badge-pending {
            background-color: #FECDD3;
            color: #991b1b;
        }
        .badge-selesai {
            background-color: #DCFCE7;
            color: #166534;
        }

        /* 📄 PAGINATION CONTROLS */
        .pagination-bar {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 16px;
            margin-top: 18px;
            padding-top: 12px;
            border-top: 1px solid var(--border-color);
        }
        .pagination-info {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
        }
        .pagination-btn-group {
            display: flex;
            gap: 6px;
        }
        .pg-btn {
            background-color: #f1f5f9;
            border: 1px solid var(--border-color);
            color: var(--color-dark-blue);
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-weight: bold;
            font-size: 12px;
        }
        .pg-btn:hover:not(:disabled) {
            background-color: var(--color-ocean-blue);
            color: #ffffff;
            border-color: var(--color-ocean-blue);
        }
        .pg-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        /* 🔥 CALL TO ACTION BUTTON */
        .cta-box {
            text-align: center;
            margin-top: 20px;
        }
        .btn-submit-main {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: var(--color-dark-blue);
            color: #ffffff;
            font-weight: 800;
            font-size: 15px;
            letter-spacing: 1px;
            padding: 18px 42px;
            border-radius: 16px;
            text-decoration: none;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.25);
        }
        .btn-submit-main:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 15px 30px rgba(22, 121, 171, 0.35);
            background: var(--color-ocean-blue);
        }
        footer {
            background-color: #ffffff;
            padding: 24px;
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            border-top: 1px solid var(--border-color);
            margin-top: auto;
        }
        @media (max-width: 768px) {
            header { padding: 16px 20px; }
            .dashboard-grid { grid-template-columns: 1fr; }
        }
        /* ANIMATIONS */
        @keyframes fadeDown {
            from { opacity: 0; transform: translateY(-24px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(32px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeLeft {
            from { opacity: 0; transform: translateX(-24px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        @keyframes rotateBorder {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }
        @keyframes pulseShadow {
            0%, 100% { box-shadow: 0 10px 25px rgba(7,65,115,0.25); }
            50%      { box-shadow: 0 10px 35px rgba(93,235,215,0.45), 0 0 0 6px rgba(93,235,215,0.1); }
        }
        @keyframes dotBlink { 
            0%,100% { opacity:1; box-shadow:0 0 8px var(--color-cyan-mint); } 
            50% { opacity:0.4; box-shadow:0 0 3px var(--color-cyan-mint); } 
        }
        .hero h1 { animation: fadeDown 0.7s 0.1s ease both; }
        .hero .subtitle { animation: fadeDown 0.7s 0.25s ease both; }
        .hero p { animation: fadeDown 0.7s 0.4s ease both; }
        .section-header { animation: fadeLeft 0.6s 0.2s ease both; }
        
        .anim-reveal {
            animation: fadeUp 0.6s ease both;
            animation-play-state: paused;
        }
        .anim-reveal.visible {
            animation-play-state: running;
        }
        .avatar-wrapper::before {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            background: conic-gradient(var(--color-cyan-mint), var(--color-lime-green), var(--color-ocean-blue), var(--color-cyan-mint));
            animation: rotateBorder 3s linear infinite;
            z-index: 0;
        }
        .avatar-wrapper img {
            position: relative;
            z-index: 1;
        }
        .btn-submit-main {
            animation: pulseShadow 2.5s ease-in-out infinite;
        }
        .btn-submit-main:hover {
            animation: none;
        }
    </style>
</head>
