            </div>

            <!-- 2. LINE CHART: TREN LAPORAN -->
            <div class="card-box">
                <div class="section-header" style="font-size: 13px; margin-bottom: 14px;">
                    <i class="fa-solid fa-chart-line" style="color: var(--color-ocean-blue);"></i> 2. TREN LAPORAN MAINTENANCE
                </div>
                <div class="chart-container-box">
                    <canvas id="trendLineChart"></canvas>
