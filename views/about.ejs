<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About Us - Cendekia Muda</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <style>
    :root {
      --color-dark-blue: #074173;
      --color-ocean-blue: #1679AB;
      --color-cyan-mint: #5DEBD7;
      --color-lime-green: #C5FF95;
      --bg-light: #f8fafc;
      --border-color: #e2e8f0;
      --text-muted: #64748b;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: "Segoe UI", sans-serif; background: var(--bg-light); color: var(--color-dark-blue); }

    /* 🚀 HEADER (DARK BLUE MODE) */
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 50px;
        background-color: var(--color-dark-blue);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }

    .logo-container {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .logo-img {
        height: 32px;
        width: auto;
        display: block;
        object-fit: contain;
    }

    .logo-divider {
        width: 1px;
        height: 22px;
        background-color: rgba(255, 255, 255, 0.3);
    }

    .logo-sub {
        font-size: 17px;
        color: var(--color-cyan-mint);
        letter-spacing: 2px;
        font-weight: 700;
        text-transform: uppercase;
    }

    nav {
        display: flex;
        align-items: center;
        gap: 28px;
    }

    nav a {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: 0.5px;
        position: relative;
        padding: 4px 0;
    }

    nav a:hover, nav a.active {
        color: #ffffff;
    }

    nav a.active::after {
        content: "";
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 100%;
        height: 3px;
        background: var(--color-cyan-mint);
        border-radius: 2px;
    }

    /* ── COVER ── */
    .cover-banner {
      position: relative;
      width: 100%;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
      background:
        linear-gradient(160deg, rgba(4,22,45,0.97) 0%, rgba(7,65,115,0.92) 45%, rgba(22,121,171,0.85) 100%),
        url('https://images.unsplash.com/photo-1518770660439-4636190af475?w=1600&q=80') center/cover no-repeat;
    }
    .cover-banner canvas { position: absolute; inset: 0; pointer-events: none; }

    /* Glow orbs */
    .cover-orb {
      position: absolute; border-radius: 50%; pointer-events: none; filter: blur(80px);
    }
    .cover-orb-1 { width:500px; height:500px; top:-100px; left:-120px; background:rgba(93,235,215,0.12); animation: orbFloat 8s ease-in-out infinite; }
    .cover-orb-2 { width:400px; height:400px; bottom:-80px; right:-100px; background:rgba(197,255,149,0.10); animation: orbFloat 10s ease-in-out infinite reverse; }
    .cover-orb-3 { width:300px; height:300px; top:40%; left:60%; background:rgba(22,121,171,0.15); animation: orbFloat 7s ease-in-out infinite 2s; }

    .cover-glow-ring {
      position: absolute;
      border-radius: 50%;
      top: 50%; left: 50%;
      transform: translate(-50%,-50%);
      pointer-events: none;
      animation: ringPulse 4s ease-in-out infinite;
    }
    .cover-glow-ring:nth-child(5) { width:600px; height:600px; border: 1px solid rgba(93,235,215,0.18); }
    .cover-glow-ring:nth-child(6) { width:900px; height:900px; border: 1px solid rgba(197,255,149,0.09); animation-delay:1.5s; }

    /* Grid overlay texture */
    .cover-grid {
      position: absolute; inset: 0; pointer-events: none;
      background-image: linear-gradient(rgba(93,235,215,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(93,235,215,0.04) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    .cover-inner { position: relative; z-index: 2; padding: 0 24px; max-width: 800px; }

    /* Badge pill */
    .cover-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(93,235,215,0.12);
      border: 1px solid rgba(93,235,215,0.35);
      color: var(--color-cyan-mint);
      font-size: 0.78rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      padding: 7px 18px; border-radius: 999px;
      margin-bottom: 28px;
      animation: fadeDown 0.7s 0s ease both;
      backdrop-filter: blur(8px);
    }
    .cover-badge-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--color-cyan-mint);
      box-shadow: 0 0 8px var(--color-cyan-mint);
      animation: dotBlink 1.5s ease-in-out infinite;
    }

    .cover-title {
    font-size: clamp(5.2rem, 10vw, 8rem);
    font-weight: 900;
    line-height: 0.95;
    margin: 0 0 10px;
    letter-spacing: -0.04em;
    animation: fadeDown 0.8s 0.15s ease both;
    }
    .word-about {
      background: linear-gradient(135deg, #ffffff 0%, #d0eaf8 60%, #90d0f5 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      display: block;
    }
    .word-us {
      background: linear-gradient(135deg, var(--color-cyan-mint) 0%, #82f3e5 50%, var(--color-lime-green) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      position: relative; display: inline-block;
      filter: drop-shadow(0 0 18px rgba(93,235,215,0.35));
    }
    .word-us::after {
      content: ''; position: absolute;
      bottom: 2px; left: 0; width: 100%; height: 4px;
      background: linear-gradient(90deg, var(--color-cyan-mint), var(--color-lime-green));
      border-radius: 2px;
      animation: lineGrow 1s 1s ease both; transform-origin: left;
      box-shadow: 0 0 12px rgba(93,235,215,0.6);
    }

    .cover-sub {
      color: rgba(255,255,255,0.88); font-size: 1rem;
      max-width: 640px; margin: 0 auto 0; line-height: 1.7;
      animation: fadeDown 0.8s 0.35s ease both;
    }

    /* FLOATING STATS BAR */
    .hero-stats-wrapper {
      position: relative;
      z-index: 10;
      max-width: 800px;
      margin: -60px auto 40px auto; 
      padding: 0 20px;
      width: 100%;
    }
    .hero-stats {
      display: flex; 
      justify-content: space-around;
      align-items: center;
      background: rgba(6, 28, 54, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(93, 235, 215, 0.25);
      border-radius: 16px;
      padding: 24px 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(93, 235, 215, 0.1);
    }
    .stat-item {
      flex: 1; text-align: center;
      padding: 0 15px;
      position: relative;
    }
    .stat-item:not(:last-child)::after {
      content: '';
      position: absolute;
      right: 0; top: 15%; bottom: 15%;
      width: 1px;
      background: linear-gradient(to bottom, transparent, rgba(93, 235, 215, 0.3), transparent);
    }
    .stat-num {
      font-size: clamp(1.6rem, 2.5vw, 2.2rem); 
      font-weight: 900; 
      line-height: 1;
      background: linear-gradient(135deg, #ffffff 20%, var(--color-cyan-mint) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .stat-label { 
      font-size: 0.72rem; 
      color: rgba(255,255,255,0.65); 
      text-transform: uppercase; 
      letter-spacing: 0.12em; 
      margin-top: 8px; 
      font-weight: 600;
    }

    /* ── CONTENT SECTION ── */
    .page-shell { width: min(1100px, calc(100% - 24px)); margin: 0 auto; padding: 80px 0 40px; background: var(--bg-light); }

    .section-label {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 0.75rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.1em;
      padding: 5px 12px; border-radius: 999px;
      margin-bottom: 12px;
    }
    .label-pink  { background: rgba(7,65,115,0.10);   color: var(--color-dark-blue); }
    .label-cyan  { background: rgba(22,121,171,0.12);  color: var(--color-ocean-blue); }
    .label-violet{ background: rgba(93,235,215,0.15);  color: #0a8a7a; }
    .label-green { background: rgba(197,255,149,0.25); color: #3a7d1e; }

    /* bento row: foto + teks */
    .bento-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border-radius: 24px;
      overflow: hidden;
      border: 1px solid var(--border-color);
      box-shadow: 0 16px 48px rgba(7,65,115,0.08);
      margin-bottom: 32px;
    }
    .bento-row.reverse { direction: rtl; }
    .bento-row.reverse > * { direction: ltr; }

    .bento-img {
      position: relative;
      min-height: 280px;
      overflow: hidden;
    }
    .bento-img img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s ease;
    }
    .bento-row:hover .bento-img img { transform: scale(1.04); }
    .bento-img::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(7,65,115,0.2), transparent);
    }

    .bento-body {
      padding: 40px 36px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .bento-body h2 {
      font-size: 1.5rem; font-weight: 700;
      color: var(--color-dark-blue); margin: 0 0 12px;
      line-height: 1.3;
    }
    .bento-body p, .bento-body li {
      color: var(--text-muted); line-height: 1.8; font-size: 0.95rem;
    }
    .bento-body ul { padding-left: 18px; margin: 10px 0 0; }
    .bento-body ul li { margin-bottom: 6px; }

    /* visi bg */
    .bento-visi   { background: linear-gradient(135deg, rgba(7,65,115,0.05),   #ffffff); }
    .bento-nilai  { background: linear-gradient(135deg, rgba(22,121,171,0.06),  #ffffff); }
    .bento-scope  { background: linear-gradient(135deg, rgba(93,235,215,0.08),  #ffffff); }
    .bento-sla    { background: linear-gradient(135deg, rgba(197,255,149,0.12), #ffffff); }

    .quote-text {
      font-style: italic; color: var(--text-muted);
      border-left: 3px solid var(--color-ocean-blue);
      padding-left: 14px; margin-bottom: 16px;
      font-size: 0.95rem; line-height: 1.75;
    }

    /* nilai grid */
    .values-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 8px; }
    .value-item {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 12px; border-radius: 12px;
      background: rgba(22,121,171,0.05);
      border: 1px solid rgba(22,121,171,0.12);
    }
    .value-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-ocean-blue); margin-top: 6px; flex-shrink: 0; }
    .value-item strong { color: var(--color-dark-blue); font-size: 0.88rem; display: block; margin-bottom: 2px; }
    .value-item span { color: var(--text-muted); font-size: 0.82rem; }

    /* scope */
    .scope-grid { display: grid; gap: 12px; margin-top: 8px; }
    .scope-box {
      padding: 14px 16px; border-radius: 12px;
      background: rgba(93,235,215,0.07);
      border: 1px solid rgba(93,235,215,0.2);
    }
    .scope-box h3 { margin: 0 0 4px; font-size: 0.9rem; color: var(--color-ocean-blue); }

    /* sla table */
    table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    th, td { padding: 10px 8px; text-align: left; border-bottom: 1px solid var(--border-color); font-size: 0.88rem; }
    th { color: var(--color-ocean-blue); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; }
    td { color: var(--text-muted); }
    tr:last-child td { border-bottom: none; }
    .badge-kritis { display:inline-block; padding:2px 8px; border-radius:999px; background:rgba(239,68,68,0.12); color:#dc2626; font-size:0.78rem; }
    .badge-rutin  { display:inline-block; padding:2px 8px; border-radius:999px; background:rgba(22,121,171,0.12); color:var(--color-ocean-blue); font-size:0.78rem; }
    .badge-non    { display:inline-block; padding:2px 8px; border-radius:999px; background:rgba(197,255,149,0.25); color:#3a7d1e; font-size:0.78rem; }

    /* ── REVEAL ── */
    .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* ── KEYFRAMES ── */
    @keyframes fadeDown { from { opacity:0; transform:translateY(-20px); } to { opacity:1; transform:translateY(0); } }
    @keyframes lineGrow { from { transform:scaleX(0); } to { transform:scaleX(1); } }
    @keyframes ringPulse { 0%,100% { transform:translate(-50%,-50%) scale(1); opacity:.5; } 50% { transform:translate(-50%,-50%) scale(1.04); opacity:1; } }
    @keyframes orbFloat { 0%,100% { transform:translateY(0) scale(1); } 50% { transform:translateY(-30px) scale(1.05); } }
    @keyframes dotBlink { 0%,100% { opacity:1; box-shadow:0 0 8px var(--color-cyan-mint); } 50% { opacity:0.4; box-shadow:0 0 3px var(--color-cyan-mint); } }

    @media (max-width: 768px) {
      header { padding: 16px 20px; }
      .bento-row { grid-template-columns: 1fr; }
      .bento-row.reverse { direction: ltr; }
      .bento-img { min-height: 220px; }
      .bento-body { padding: 28px 22px; }
      .values-grid { grid-template-columns: 1fr; }
      .hero-stats { flex-wrap: wrap; gap: 12px; padding: 16px 20px; }
      .stat-item { flex: 1 1 40%; padding-bottom: 12px; }
      .stat-item:not(:last-child)::after { display: none; }
      .cover-title { font-size: clamp(3rem, 12vw, 5rem); }
    }
  </style>
</head>
