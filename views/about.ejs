      <i class="fa-solid fa-house"></i> Home
    </a>
    <button onclick="history.back()" style="display:inline-flex; align-items:center; gap:8px; padding:10px 24px; border-radius:999px; border:1px solid var(--border-color); background:#fff; color:var(--color-dark-blue); font-size:14px; font-weight:700; cursor:pointer;">
      <i class="fa-solid fa-arrow-left"></i> Kembali
    </button>
  </div>

  <footer style="background:#ffffff; padding:32px 24px; text-align:center; font-size:12px; color:var(--text-muted); border-top:1px solid var(--border-color);">
