<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About Us - Cendekia Muda</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <style>
    :root {
      --panel: rgba(10,16,35,0.86);
      --border: rgba(255,255,255,0.12);
      --muted: #cbd5e1;
      --pink: #f472b6;
      --cyan: #22d3ee;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: "Segoe UI", sans-serif; background: #0b1120; color: #fff; }

    /* ── COVER ── */
    .cover-banner {
      position: relative;
      width: 100%;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;

      /* ============================================================
         GANTI FOTO BACKGROUND BANNER:
         Ubah URL di bawah ini dengan link foto atau path foto kamu.
         Contoh lokal: url('/images/foto-banner.jpg')
         Contoh online: url('https://...')
         ============================================================ */
      background:
        linear-gradient(135deg, rgba(5,8,20,0.88) 0%, rgba(5,8,20,0.72) 50%, rgba(5,8,20,0.92) 100%),
        url('https://images.unsplash.com/photo-1518770660439-4636190af475?w=1600&q=80') center/cover no-repeat;
    }
    .cover-banner canvas { position: absolute; inset: 0; pointer-events: none; }
    .cover-glow-ring {
      position: absolute;
      border-radius: 50%;
      top: 50%; left: 50%;
      transform: translate(-50%,-50%);
      pointer-events: none;
      animation: ringPulse 4s ease-in-out infinite;
    }
    .cover-glow-ring:nth-child(2) { width:600px; height:600px; border: 1px solid rgba(34,211,238,0.08); }
    .cover-glow-ring:nth-child(3) { width:900px; height:900px; border: 1px solid rgba(244,114,182,0.05); animation-delay:1s; }

    .cover-inner { position: relative; z-index: 2; padding: 0 24px; }
    .cover-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 18px; border-radius: 999px;
      border: 1px solid rgba(34,211,238,0.35);
      background: rgba(34,211,238,0.08);
      color: #67e8f9; font-size: 0.85rem;
      letter-spacing: 0.08em; text-transform: uppercase;
      margin-bottom: 28px;
      animation: fadeDown 0.7s ease both;
    }
    .cover-title {
      font-size: clamp(3rem, 7vw, 6.5rem);
      font-weight: 800; line-height: 1.05;
      margin: 0 0 24px; letter-spacing: -0.02em;
      animation: fadeDown 0.8s 0.15s ease both;
    }
    .word-about {
      background: linear-gradient(135deg, #fff 30%, #94a3b8);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .word-us {
      background: linear-gradient(135deg, var(--cyan), var(--pink));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      position: relative;
    }
    .word-us::after {
      content: ''; position: absolute;
      bottom: -4px; left: 0; width: 100%; height: 3px;
      background: linear-gradient(90deg, var(--cyan), var(--pink));
      border-radius: 2px;
      animation: lineGrow 1s 1s ease both; transform-origin: left;
    }
    .cover-sub {
      color: #94a3b8; font-size: clamp(1rem, 1.5vw, 1.2rem);
      max-width: 560px; margin: 0 auto 40px; line-height: 1.7;
      animation: fadeDown 0.8s 0.3s ease both;
    }

    /* ── CONTENT SECTION ── */
    .page-shell { width: min(1100px, calc(100% - 24px)); margin: 0 auto; padding: 80px 0 40px; }

    .section-label {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 0.75rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.1em;
      padding: 5px 12px; border-radius: 999px;
      margin-bottom: 12px;
    }
    .label-pink  { background: rgba(244,114,182,0.12); color: #f472b6; }
    .label-cyan  { background: rgba(34,211,238,0.12);  color: #22d3ee; }
    .label-violet{ background: rgba(167,139,250,0.12); color: #a78bfa; }
    .label-green { background: rgba(52,211,153,0.12);  color: #34d399; }

    /* bento row: foto + teks */
    .bento-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border-radius: 24px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.07);
      box-shadow: 0 16px 48px rgba(0,0,0,0.35);
      margin-bottom: 32px;
    }
    .bento-row.reverse { direction: rtl; }
    .bento-row.reverse > * { direction: ltr; }

    .bento-img {
      position: relative;
      min-height: 280px;
      overflow: hidden;
    }
    .bento-img img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s ease;
    }
    .bento-row:hover .bento-img img { transform: scale(1.04); }
    .bento-img::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(5,8,20,0.3), transparent);
    }

    .bento-body {
      padding: 40px 36px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .bento-body h2 {
      font-size: 1.5rem; font-weight: 700;
      color: #f1f5f9; margin: 0 0 12px;
      line-height: 1.3;
    }
    .bento-body p, .bento-body li {
      color: #94a3b8; line-height: 1.8; font-size: 0.95rem;
    }
    .bento-body ul { padding-left: 18px; margin: 10px 0 0; }
    .bento-body ul li { margin-bottom: 6px; }

    /* visi bg */
    .bento-visi   { background: linear-gradient(135deg, rgba(244,114,182,0.08), rgba(10,16,35,0.95)); }
    .bento-nilai  { background: linear-gradient(135deg, rgba(34,211,238,0.08),  rgba(10,16,35,0.95)); }
    .bento-scope  { background: linear-gradient(135deg, rgba(167,139,250,0.08), rgba(10,16,35,0.95)); }
    .bento-sla    { background: linear-gradient(135deg, rgba(52,211,153,0.08),  rgba(10,16,35,0.95)); }

    .quote-text {
      font-style: italic; color: #cbd5e1;
      border-left: 3px solid #f472b6;
      padding-left: 14px; margin-bottom: 16px;
      font-size: 0.95rem; line-height: 1.75;
    }

    /* nilai grid */
    .values-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 8px; }
    .value-item {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 12px; border-radius: 12px;
      background: rgba(34,211,238,0.05);
      border: 1px solid rgba(34,211,238,0.1);
    }
    .value-dot { width: 8px; height: 8px; border-radius: 50%; background: #22d3ee; margin-top: 6px; flex-shrink: 0; }
    .value-item strong { color: #e2e8f0; font-size: 0.88rem; display: block; margin-bottom: 2px; }
    .value-item span { color: #64748b; font-size: 0.82rem; }

    /* scope */
    .scope-grid { display: grid; gap: 12px; margin-top: 8px; }
    .scope-box {
      padding: 14px 16px; border-radius: 12px;
      background: rgba(167,139,250,0.07);
      border: 1px solid rgba(167,139,250,0.15);
    }
    .scope-box h3 { margin: 0 0 4px; font-size: 0.9rem; color: #c4b5fd; }

    /* sla table */
    table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    th, td { padding: 10px 8px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.06); font-size: 0.88rem; }
    th { color: #6ee7b7; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; }
    td { color: #94a3b8; }
    tr:last-child td { border-bottom: none; }
    .badge-kritis { display:inline-block; padding:2px 8px; border-radius:999px; background:rgba(239,68,68,0.15); color:#fca5a5; font-size:0.78rem; }
    .badge-rutin  { display:inline-block; padding:2px 8px; border-radius:999px; background:rgba(251,191,36,0.15); color:#fde68a; font-size:0.78rem; }
    .badge-non    { display:inline-block; padding:2px 8px; border-radius:999px; background:rgba(52,211,153,0.15); color:#6ee7b7; font-size:0.78rem; }

    /* ── REVEAL ── */
    .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* ── KEYFRAMES ── */
    @keyframes fadeDown { from { opacity:0; transform:translateY(-20px); } to { opacity:1; transform:translateY(0); } }
    @keyframes lineGrow { from { transform:scaleX(0); } to { transform:scaleX(1); } }
    @keyframes ringPulse { 0%,100% { transform:translate(-50%,-50%) scale(1); opacity:.5; } 50% { transform:translate(-50%,-50%) scale(1.04); opacity:1; } }

    @media (max-width: 768px) {
      .bento-row { grid-template-columns: 1fr; }
      .bento-row.reverse { direction: ltr; }
      .bento-img { min-height: 220px; }
      .bento-body { padding: 28px 22px; }
      .values-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
