      <span><i class="fa-solid fa-phone" style="margin-right:6px; color:var(--color-ocean-blue);"></i>(022) 710 2888</span>
      <span><i class="fa-solid fa-envelope" style="margin-right:6px; color:var(--color-ocean-blue);"></i>info@cendekiamuda.sch.id</span>
    </div>
    <p style="margin:4px 0;"><i class="fa-solid fa-location-dot" style="margin-right:6px; color:var(--color-ocean-blue);"></i>JL Puri Ayu Pratama III No. 17 Arcamanik Bandung</p>
    <p style="margin-top:12px; padding-top:12px; border-top:1px solid var(--border-color);">© 2026 Cendekia Muda. All rights reserved.</p>
  </footer>

  <script>
    // Particles
    const canvas = document.getElementById('particleCanvas');
    const ctx = canvas.getContext('2d');
    const particles = [];
    function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
    resize();
    window.addEventListener('resize', resize);
    for (let i = 0; i < 90; i++) {
      particles.push({ x: Math.random()*window.innerWidth, y: Math.random()*window.innerHeight, r: Math.random()*1.8+0.3, dx: (Math.random()-0.5)*0.35, dy: (Math.random()-0.5)*0.35, alpha: Math.random()*0.45+0.08, color: ['93,235,215','197,255,149','255,255,255'][Math.floor(Math.random()*3)] });
    }
    function drawParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
        ctx.fillStyle = `rgba(${p.color},${p.alpha})`; ctx.fill();
        p.x += p.dx; p.y += p.dy;
        if (p.x < 0 || p.x > canvas.width) p.dx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.dy *= -1;
      });
      requestAnimationFrame(drawParticles);
    }
    drawParticles();

    // Counter animation
    function animateCounter(el, target, suffix, duration) {
      let start = 0, step = target / (duration / 16);
      const timer = setInterval(() => {
        start = Math.min(start + step, target);
        el.textContent = Math.floor(start) + suffix;
        if (start >= target) clearInterval(timer);
      }, 16);
    }
    setTimeout(() => {
      animateCounter(document.getElementById('stat1'), 5, '+', 1200);
      animateCounter(document.getElementById('stat2'), 500, '+', 1500);
      animateCounter(document.getElementById('stat3'), 98, '%', 1400);
      animateCounter(document.getElementById('stat4'), 2, ' Tim', 800);
    }, 600);

    // Scroll reveal
    const observer = new IntersectionObserver(entries => {
      entries.forEach((e, i) => { if (e.isIntersecting) { setTimeout(() => e.target.classList.add('visible'), i*100); observer.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</body>
</html>