<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form Pengaduan IT - Cendekia Muda</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #0b1120;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 40px;
            background-color: rgba(11, 17, 32, 0.9);
            border-bottom: 1px solid #1f293d;
        }
        .logo-text { font-size: 20px; font-weight: 800; color: #22c55e; }
        .logo-sub { font-size: 11px; color: #d1d5db; }
        nav a { color: #9ca3af; text-decoration: none; font-size: 13px; margin-left: 15px; }

        main {
            flex-grow: 1;
            padding: 30px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .container-box { width: 100%; max-width: 42rem; }
        .card {
            background-color: #131c31;
            border: 1px solid #1f293d;
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
        }
        h1 { font-size: 22px; color: #fce7f3; margin-top: 0; }
        p.subtitle { font-size: 13px; color: #9ca3af; margin-bottom: 24px; }
        
        .alert-success { background-color: rgba(22, 163, 74, 0.2); border: 1px solid #22c55e; color: #86efac; font-size: 13px; padding: 12px; border-radius: 12px; margin-bottom: 20px; }
        .alert-error { background-color: rgba(220, 38, 38, 0.2); border: 1px solid #ef4444; color: #fca5a5; font-size: 13px; padding: 12px; border-radius: 12px; margin-bottom: 20px; }
        
        .form-row { display: flex; gap: 16px; }
        .form-group { flex: 1; margin-bottom: 18px; }
        label { display: block; color: #d1d5db; margin-bottom: 6px; font-size: 12px; font-weight: 600; }
        .required { color: #ef4444; }
        
        input, select, textarea {
            width: 100%;
            background-color: #1b253b;
            border: 1px solid #374151;
            border-radius: 12px;
            padding: 12px;
            color: #ffffff;
            font-size: 13px;
            box-sizing: border-box;
            outline: none;
        }
        
        .upload-box {
            border: 2px dashed #374151;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            background-color: #1b253b;
            cursor: pointer;
        }
        
        button.btn-submit {
            width: 100%;
            background-color: #fbcfe8;
            color: #111827;
            font-weight: bold;
            padding: 14px;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            font-size: 13px;
            margin-top: 12px;
        }
        
        footer { background-color: #070b14; padding: 20px; text-align: center; font-size: 12px; color: #9ca3af; border-top: 1px solid #1f293d; }
        
        @media (max-width: 640px) { .form-row { flex-direction: column; gap: 0; } }
    </style>
</head>
<body>

    <header>
        <div>
            <span class="logo-text">KCM</span>
            <span class="logo-sub">LAYANAN & MAINTENANCE</span>
        </div>
        <nav>
            <a href="/it-support"><i class="fa-solid fa-arrow-left"></i> Kembali ke IT Support</a>
        </nav>
    </header>

    <main>
        <div class="container-box">
            <div class="card">
                <h1><i class="fa-solid fa-laptop-code" style="color: #fbcfe8;"></i> Form Pengaduan IT Support</h1>
                <p class="subtitle">Isi data di bawah ini untuk mengajukan perbaikan kendala IT.</p>

                <% if (typeof success !== 'undefined' && success === 'true') { %>
                    <div class="alert-success">
                        <i class="fa-solid fa-circle-check"></i> Data berhasil dikirim dan otomatis tercatat di Spreadsheet!
                    </div>
                <% } else if (typeof success !== 'undefined' && success === 'false') { %>
                    <div class="alert-error">
                        <i class="fa-solid fa-circle-xmark"></i> Gagal mengirim data. Periksa koneksi atau konfigurasi spreadsheet.
                    </div>
                <% } %>

                <form action="/it-support/submit" method="POST">
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Nama Pelapor <span class="required">*</span></label>
                            <input type="text" name="nama_request" required placeholder="Masukkan nama lengkap">
                        </div>
                        <div class="form-group">
                            <label>Unit Sekolah <span class="required">*</span></label>
                            <select name="unit" id="unitSelect" required onchange="updateKelasOptions()">
                                <option value="" disabled selected>Pilih Unit</option>
                                <option value="Daycare">Daycare</option>
                                <option value="TK">TK</option>
                                <option value="SD Bandung">SD Bandung</option>
                                <option value="SD Bilingual">SD Bilingual</option>
                                <option value="SD Makasar">SD Makasar</option>
                                <option value="SMP">SMP</option>
                                <option value="SMA">SMA</option>
                                <option value="UPPP">UPPP</option>
                                <option value="Catering">Catering</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Kelas / Level <span class="required">*</span></label>
                            <select name="kelas" id="kelasSelect" required>
                                <option value="" disabled selected>Pilih Unit Terlebih Dahulu</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Kategori Kendala <span class="required">*</span></label>
                            <select name="permasalahan" required>
                                <option value="" disabled selected>Pilih Kategori</option>
                                <option value="Internet / Wi-Fi">Internet / Wi-Fi</option>
                                <option value="Komputer / Laptop">Komputer / Laptop</option>
                                <option value="Printer / Scanner">Printer / Scanner</option>
                                <option value="Webcam">Webcam</option>
                                <option value="Microphone / Audio">Microphone / Audio</option>
                                <option value="TV / Display">TV / Display</option>
                                <option value="Projector">Projector</option>
                                <option value="Sistem / Aplikasi">Sistem / Aplikasi</option>
                                <option value="Lainnya">Lainnya</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Detail Permasalahan <span class="required">*</span></label>
                        <textarea name="detail_permasalahan" rows="4" required placeholder="Jelaskan secara detail kerusakan atau keluhan..."></textarea>
                    </div>

                    <div class="form-group">
                        <label>Unggah Foto (Bukti Kerusakan) <span style="color: #6b7280;">(Opsional)</span></label>
                        <div class="upload-box" onclick="document.getElementById('fileInput').click()">
                            <i class="fa-solid fa-cloud-arrow-up" style="font-size: 20px; color: #9ca3af;"></i>
                            <p style="margin: 4px 0 0 0; font-size: 11px; color: #9ca3af;">Klik untuk unggah file (JPG, PNG MAX 5MB)</p>
                            <input type="file" id="fileInput" name="foto" accept="image/*" style="display: none;">
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">
                        <i class="fa-solid fa-paper-plane"></i> KIRIM LAPORAN PENGADUAN
                    </button>
                </form>
            </div>
        </div>
    </main>

    <footer>
        <p>© 2024 PORTAL MAINTENANCE INTERNAL - CENDEKIA MUDA. All rights reserved.</p>
    </footer>

    <script>
        function updateKelasOptions() {
            const unit = document.getElementById("unitSelect").value;
            const kelasSelect = document.getElementById("kelasSelect");
            kelasSelect.innerHTML = '<option value="" disabled selected>Pilih Kelas / Level</option>';
            let options = [];

            if (unit.includes("SD")) {
                options = ["Level 1", "Level 2", "Level 3", "Level 4", "Level 5", "Level 6"];
            } else if (unit === "SMP") {
                options = ["Kelas 7A", "Kelas 7B", "Kelas 7C", "Kelas 8A", "Kelas 8B", "Kelas 8C", "Kelas 9A", "Kelas 9B", "Kelas 9C"];
            } else if (unit === "SMA") {
                options = ["Kelas 10A", "Kelas 10B", "Kelas 10C", "Kelas 11A", "Kelas 11B", "Kelas 11C", "Kelas 12A", "Kelas 12B", "Kelas 12C"];
            } else {
                options = ["Non-Kelas / Staf", "Lainnya"];
            }

            options.forEach(opt => {
                const el = document.createElement("option");
                el.value = opt;
                el.textContent = opt;
                kelasSelect.appendChild(el);
            });
        }
    </script>
</body>
</html>