<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>General Affair - Cendekia Muda</title>
    <!-- FontAwesome & Chart.js -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --bg-light: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --color-dark-blue: #074173;
            --color-ocean-blue: #1679AB;
            --color-cyan-mint: #5DEBD7;
            --color-lime-green: #C5FF95;
            --text-main: #074173;
            --text-muted: #64748b;
        }
        *, *::before, *::after {
            box-sizing: border-box;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        body, input, select, button, textarea {
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: var(--bg-light);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }
        /* HEADER & NAVIGATION */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 50px;
            background: #074173;
            border-bottom: 1px solid rgba(93, 235, 215, 0.2);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
            box-shadow: 0 2px 16px rgba(7, 65, 115, 0.3);
        }
        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .logo-img {
            height: 32px;
            width: auto;
            display: block;
            object-fit: contain;
        }
        .logo-divider {
            width: 1px;
            height: 22px;
            background-color: rgba(255,255,255,0.2);
        }
        .logo-sub {
            font-size: 17px;
            color: var(--color-cyan-mint);
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
        }
        nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }
        nav a {
            color: rgba(255,255,255,0.75);
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.5px;
            position: relative;
            padding: 4px 0;
        }
        nav a:hover, nav a.active {
            color: #ffffff;
        }
        nav a.active::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--color-cyan-mint), var(--color-lime-green));
            border-radius: 2px;
        }
        /* HERO BANNER */
        .hero {
            position: relative;
            padding: 130px 20px 170px 20px; 
            min-height: 520px; 
            text-align: center;
            background: 
                linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.12) 1px, transparent 1px),
                linear-gradient(135deg, rgba(22, 121, 171, 0.88) 0%, rgba(7, 65, 115, 0.95) 100%),
                url('https://images.unsplash.com/photo-1497366216548-37526070297c?w=1600&q=80') center/cover no-repeat;
            background-size: 35px 35px, 35px 35px, cover, cover;
            color: #ffffff;
            overflow: hidden;
        }
        #ga-animation-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
        }
        .hero-inner {
            position: relative;
            z-index: 2;
            max-width: 850px;
            margin: 0 auto;
        }
        .badge-capsule {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 20px;
            border-radius: 30px;
            background: rgba(197, 255, 149, 0.15);
            border: 1px solid #C5FF95;
            color: #C5FF95;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 24px;
            backdrop-filter: blur(8px);
        }
        .badge-capsule .dot-pulse {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #C5FF95;
            box-shadow: 0 0 10px #C5FF95;
            animation: pulseGlow 1.5s infinite;
        }
        .hero h1 {
            font-size: clamp(2.4rem, 5.5vw, 4rem);
            font-weight: 900;
            margin: 0 0 10px 0;
            letter-spacing: -0.02em;
            line-height: 1.1;
            background: linear-gradient(135deg, #ffffff 0%, #d0eaf8 60%, #90d0f5 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .hero .subtitle {
            font-size: clamp(1.4rem, 3.2vw, 2.5rem);
            background: linear-gradient(135deg, var(--color-cyan-mint) 0%, #82f3e5 50%, var(--color-lime-green) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            font-weight: 900;
            letter-spacing: 1.5px;
            margin-bottom: 20px;
            filter: drop-shadow(0 0 18px rgba(93,235,215,0.35));
        }
        .hero p {
            color: rgba(255,255,255,0.88);
            font-size: 1rem;
            max-width: 640px;
            margin: 0 auto;
            line-height: 1.7;
        }
        /* FLOATING STATS BAR */
        .hero-stats-wrapper {
            position: relative;
            z-index: 10;
            max-width: 800px;
            margin: -60px auto 40px auto; 
            padding: 0 20px;
            width: 100%;
        }
        .hero-stats {
            display: flex; 
            justify-content: space-around;
            align-items: center;
            background: rgba(6, 28, 54, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(93, 235, 215, 0.25);
            border-radius: 16px;
            padding: 24px 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(93, 235, 215, 0.1);
        }
        .stat-item {
            flex: 1; text-align: center;
            padding: 0 15px;
            position: relative;
        }
        .stat-item:not(:last-child)::after {
            content: '';
            position: absolute;
            right: 0; top: 15%; bottom: 15%;
            width: 1px;
            background: linear-gradient(to bottom, transparent, rgba(93, 235, 215, 0.3), transparent);
        }
        .stat-num {
            font-size: clamp(1.6rem, 2.5vw, 2.2rem); 
            font-weight: 900; 
            line-height: 1;
            background: linear-gradient(135deg, #ffffff 20%, var(--color-cyan-mint) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .stat-label { 
            font-size: 0.72rem; 
            color: rgba(255,255,255,0.65); 
            text-transform: uppercase; 
            letter-spacing: 0.12em; 
            margin-top: 8px; 
            font-weight: 600;
        }
        /* MAIN CONTAINER */
        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 10px 24px 70px 24px;
            width: 100%;
        }
        .section-header {
            font-size: 15px;
            font-weight: 800;
            color: var(--color-dark-blue);
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 24px;
            margin-bottom: 45px;
        }
        .team-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 22px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
            cursor: pointer;
        }
        .team-card:hover {
            transform: translateY(-8px) scale(1.01);
            border-color: var(--color-ocean-blue);
            box-shadow: 0 15px 30px rgba(22, 121, 171, 0.15);
        }
        .team-body {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 16px;
        }
        .avatar-wrapper {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, var(--color-ocean-blue), var(--color-cyan-mint));
            flex-shrink: 0;
        }
        .avatar-wrapper img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            background-color: #f1f5f9;
        }
        .team-info h3 {
            margin: 0;
            font-size: 17px;
            font-weight: 800;
            color: var(--color-dark-blue);
            letter-spacing: 0.5px;
        }
        .team-info .role-badge {
            display: inline-block;
            background: rgba(22, 121, 171, 0.1);
            color: var(--color-ocean-blue);
            font-size: 10px;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 6px;
            margin: 6px 0 8px 0;
            letter-spacing: 0.8px;
        }
        .contact-list {
            font-size: 11px;
            color: var(--text-muted);
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .btn-contact {
            background-color: #f1f5f9;
            border: 1px solid var(--border-color);
            color: var(--color-dark-blue);
            font-size: 12px;
            font-weight: 700;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            text-decoration: none;
        }
        .team-card:hover .btn-contact {
            background-color: var(--color-ocean-blue);
            color: #ffffff;
            border-color: var(--color-ocean-blue);
        }
        
        /* DASHBOARD GRID & CHARTS */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin-bottom: 35px;
        }
        .card-box {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 22px;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .card-box:hover {
            border-color: var(--color-ocean-blue);
            transform: translateY(-4px);
        }
        .chart-container-box {
            position: relative;
            height: 180px;
            width: 100%;
        }
        .chart-center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
        }
        .chart-center-text .number {
            font-size: 22px;
            font-weight: 900;
            color: var(--color-dark-blue);
            line-height: 1;
        }
        .chart-center-text .label {
            font-size: 9px;
            color: var(--text-muted);
            letter-spacing: 0.8px;
            margin-top: 3px;
        }
        .chart-legend-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin-top: 14px;
            padding-top: 10px;
            border-top: 1px dashed var(--border-color);
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
        }
        .legend-color-box {
            width: 10px;
            height: 10px;
            border-radius: 3px;
        }

        /* TABLE & FILTER CONTAINER */
        .table-box-full {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 22px;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
            margin-bottom: 40px;
        }
        .table-filter-bar {
            display: flex;
            gap: 12px;
            margin-bottom: 18px;
            flex-wrap: wrap;
            background-color: #f8fafc;
            padding: 16px;
            border-radius: 16px;
            border: 1px solid var(--border-color);
            width: 100%;
            box-sizing: border-box;
        }
        .filter-group {
            flex: 1 1 180px;
            min-width: 150px;
            position: relative;
        }

        /* CUSTOM DROPDOWN STYLING (MATCHING IT SUPPORT CODE) */
        .filter-control {
            width: 100%;
            padding: 0 16px;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            background-color: #ffffff;
            color: var(--color-dark-blue);
            font-size: 13px;
            font-weight: 600;
            outline: none;
            box-sizing: border-box;
            height: 42px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
        }
        .custom-select-wrapper {
            position: relative;
            width: 100%;
            user-select: none;
        }
        .custom-select-trigger {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            height: 42px;
            padding: 0 16px;
            font-size: 13px;
            font-weight: 600;
            color: var(--color-dark-blue);
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
        }
        .custom-select-trigger:hover {
            border-color: var(--color-ocean-blue);
        }
        .custom-select-wrapper.open .custom-select-trigger {
            border-color: var(--color-ocean-blue);
            box-shadow: 0 0 0 3px rgba(22, 121, 171, 0.15);
        }
        .custom-select-options {
            position: absolute;
            top: calc(100% + 6px);
            left: 0; right: 0;
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.15);
            z-index: 99;
            max-height: 220px;
            overflow-y: auto;
            display: none;
            padding: 6px 0;
        }
        .custom-select-wrapper.open .custom-select-options {
            display: block;
            animation: fadeDown 0.2s ease;
        }
        .custom-option {
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .custom-option:hover, .custom-option.selected {
            background-color: rgba(22, 121, 171, 0.08);
            color: var(--color-ocean-blue);
        }
        
        .table-responsive {
            overflow-x: auto;
        }
        .custom-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 13px;
        }
        .custom-table th {
            background-color: #f1f5f9;
            color: var(--color-dark-blue);
            font-weight: 700;
            padding: 12px 14px;
            border-bottom: 2px solid var(--border-color);
            white-space: nowrap;
        }
        .custom-table td {
            padding: 12px 14px;
            border-bottom: 1px solid var(--border-color);
            color: #334155;
            vertical-align: middle;
        }
        .custom-table tr:last-child td {
            border-bottom: none;
        }
        .custom-table tr:hover td {
            background-color: #f8fafc;
        }
        .badge-status {
            font-weight: 700;
            font-size: 11px;
            padding: 5px 12px;
            border-radius: 12px;
            display: inline-block;
            text-align: center;
        }
        .badge-acc {
            background-color: #CBD5E1;
            color: #475569;
        }
        .badge-proses {
            background-color: #FEF08A;
            color: #854d0e;
        }
        .badge-pending {
            background-color: #FECDD3;
            color: #991b1b;
        }
        .badge-selesai {
            background-color: #DCFCE7;
            color: #166534;
        }
        .pagination-bar {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 16px;
            margin-top: 18px;
            padding-top: 12px;
            border-top: 1px solid var(--border-color);
        }
        .pagination-info {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
        }
        .pagination-btn-group {
            display: flex;
            gap: 6px;
        }
        .pg-btn {
            background-color: #f1f5f9;
            border: 1px solid var(--border-color);
            color: var(--color-dark-blue);
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-weight: bold;
            font-size: 12px;
        }
        .pg-btn:hover:not(:disabled) {
            background-color: var(--color-ocean-blue);
            color: #ffffff;
            border-color: var(--color-ocean-blue);
        }
        .pg-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
        .cta-box {
            text-align: center;
            margin-top: 20px;
        }
        .btn-submit-main {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: var(--color-dark-blue);
            color: #ffffff;
            font-weight: 800;
            font-size: 15px;
            letter-spacing: 1px;
            padding: 18px 42px;
            border-radius: 16px;
            text-decoration: none;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.25);
        }
        .btn-submit-main:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 15px 30px rgba(22, 121, 171, 0.35);
            background: var(--color-ocean-blue);
        }
        footer {
            background-color: #ffffff;
            padding: 24px;
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            border-top: 1px solid var(--border-color);
            margin-top: auto;
        }
        @media (max-width: 768px) {
            header { padding: 16px 20px; }
            .hero { padding: 90px 15px 140px 15px; }
            .hero-stats { flex-wrap: wrap; gap: 12px; padding: 16px 20px; }
            .stat-item { flex: 1 1 40%; padding-bottom: 12px; }
            .stat-item:not(:last-child)::after { display: none; }
            .dashboard-grid { grid-template-columns: 1fr; }
        }
        /* ANIMATIONS */
        @keyframes pulseGlow {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 255, 149, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(197, 255, 149, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 255, 149, 0); }
        }
        @keyframes fadeDown {
            from { opacity: 0; transform: translateY(-24px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(32px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeLeft {
            from { opacity: 0; transform: translateX(-24px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        @keyframes rotateBorder {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }
        @keyframes pulseShadow {
            0%, 100% { box-shadow: 0 10px 25px rgba(7,65,115,0.25); }
            50%      { box-shadow: 0 10px 35px rgba(93,235,215,0.45), 0 0 0 6px rgba(93,235,215,0.1); }
        }
        .hero h1 { animation: fadeDown 0.7s 0.1s ease both; }
        .hero .subtitle { animation: fadeDown 0.7s 0.25s ease both; }
        .hero p { animation: fadeDown 0.7s 0.4s ease both; }
        .section-header { animation: fadeLeft 0.6s 0.2s ease both; }
        
        .anim-reveal {
            animation: fadeUp 0.6s ease both;
            animation-play-state: paused;
        }
        .anim-reveal.visible {
            animation-play-state: running;
        }
        .avatar-wrapper::before {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            background: conic-gradient(var(--color-cyan-mint), var(--color-lime-green), var(--color-ocean-blue), var(--color-cyan-mint));
            animation: rotateBorder 3s linear infinite;
            z-index: 0;
        }
        .avatar-wrapper img {
            position: relative;
            z-index: 1;
        }
        .btn-submit-main {
            animation: pulseShadow 2.5s ease-in-out infinite;
        }
        .btn-submit-main:hover {
            animation: none;
        }
    </style>
</head>
<body>
    <!-- HEADER -->
    <%- include('navbar') %>
    
    <!-- HERO BANNER SECTION WITH ANIMATED CANVAS BACKGROUND & GEARS -->
    <div class="hero">
        <canvas id="ga-animation-canvas"></canvas>
        <div class="hero-inner">
            <div class="badge-capsule">
                <div class="dot-pulse"></div> GA & FACILITY OPERATIONS CENTER
            </div>
            <h1>LAYANAN GENERAL AFFAIR</h1>
            <div class="subtitle">CENDEKIA MUDA</div>
            <p>Pusat Layanan Pemeliharaan Sarana, Prasarana, & Fasilitas Gedung. Mengatasi Kendala Operasional dengan Cepat, Tepat, dan Nyaman.</p>
        </div>
    </div>
    
    <!-- FLOATING STATS BAR -->
    <% 
        let totalLaporan = (typeof reports !== 'undefined' && Array.isArray(reports)) ? reports.length : 0; 
    %>
    <div class="hero-stats-wrapper">
        <div class="hero-stats">
            <div class="stat-item">
                <div class="stat-num" id="statHero1">30 Menit</div>
                <div class="stat-label">SLA Respon GA</div>
            </div>
            <div class="stat-item">
                <div class="stat-num" id="statHero2"><%= totalLaporan %></div>
                <div class="stat-label">Laporan GA Masuk</div>
            </div>
            <div class="stat-item">
                <div class="stat-num" id="statHero3">98%</div>
                <div class="stat-label">Fasilitas Normal</div>
            </div>
        </div>
    </div>

    <main class="container">
        <!-- SECTION TIM GENERAL AFFAIR -->
        <div class="section-header">
            <i class="fa-solid fa-users-gear" style="color: var(--color-ocean-blue);"></i> TIM GENERAL AFFAIR / PIC
        </div>

        <!-- SECTION DATA TABEL DARI GOOGLE SHEET GA -->
        <div class="section-header">
            <i class="fa-solid fa-table" style="color: var(--color-ocean-blue);"></i> LAPORAN GA (REAL-TIME GOOGLE SHEET GA)
        </div>
        <div class="table-box-full">
            <!-- BARIS FILTER CUSTOM DROPDOWN -->
            <div class="table-filter-bar">
                <!-- DROPDOWN UNIT SEKOLAH -->
                <div class="filter-group">
                    <div class="custom-select-wrapper" id="unitDropdownWrapper">
                        <div class="custom-select-trigger">
                            <span>Pilih Unit</span>
                            <i class="fa-solid fa-chevron-down" style="font-size: 11px;"></i>
                        </div>
                        <div class="custom-select-options">
                            <div class="custom-option selected" data-value="">Semua Unit</div>
                            <div class="custom-option" data-value="DAYCARE">DAYCARE</div>
                            <div class="custom-option" data-value="TK">TK</div>
                            <div class="custom-option" data-value="SD AREN">SD AREN</div>
                            <div class="custom-option" data-value="SD PURAY">SD PURAY</div>
                            <div class="custom-option" data-value="SMP">SMP</div>
                            <div class="custom-option" data-value="SMA">SMA</div>
                            <div class="custom-option" data-value="UPPP">UPPP</div>
                            <div class="custom-option" data-value="CATERING">CATERING</div>
                        </div>
                    </div>
                </div>
                <!-- DROPDOWN STATUS -->
                <div class="filter-group">
                    <div class="custom-select-wrapper" id="statusDropdownWrapper">
                        <div class="custom-select-trigger">
                            <span>Semua Status</span>
                            <i class="fa-solid fa-chevron-down" style="font-size: 11px;"></i>
                        </div>
                        <div class="custom-select-options">
                            <div class="custom-option selected" data-value="">Semua Status</div>
                            <div class="custom-option" data-value="Dalam Antrian">Dalam Antrian</div>
                            <div class="custom-option" data-value="Diproses">Diproses</div>
                            <div class="custom-option" data-value="Pending">Pending</div>
                            <div class="custom-option" data-value="Selesai">Selesai</div>
                        </div>
                    </div>
                </div>
                <!-- DROPDOWN PERMASALAHAN GA -->
                <div class="filter-group">
                    <div class="custom-select-wrapper" id="problemDropdownWrapper">
                        <div class="custom-select-trigger">
                            <span>Pilih Permasalahan</span>
                            <i class="fa-solid fa-chevron-down" style="font-size: 11px;"></i>
                        </div>
                        <div class="custom-select-options">
                            <div class="custom-option selected" data-value="">Semua Permasalahan</div>
                            <div class="custom-option" data-value="AC / Pendingin Ruangan">AC / Pendingin Ruangan</div>
                            <div class="custom-option" data-value="Kelistrikan & Lampu">Kelistrikan & Lampu</div>
                            <div class="custom-option" data-value="Plumbing & Toilet">Plumbing & Toilet</div>
                            <div class="custom-option" data-value="Meja, Kursi & Mebel">Meja, Kursi & Mebel</div>
                            <div class="custom-option" data-value="Pintu, Jendela & Kunci">Pintu, Jendela & Kunci</div>
                            <div class="custom-option" data-value="Kebersihan & Sanitasi">Kebersihan & Sanitasi</div>
                            <div class="custom-option" data-value="Bangunan & Cat">Bangunan & Cat</div>
                            <div class="custom-option" data-value="Lainnya">Lainnya</div>
                        </div>
                    </div>
                </div>
                <!-- SEARCH KEYWORD -->
                <div class="filter-group">
                    <input type="text" id="filterKeyword" class="filter-control" placeholder="Cari Nama / Detail..." oninput="applyFilters()">
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Waktu/Tanggal</th>
                            <th>Unit</th>
                            <th>Nama Request</th>
                            <th>Permasalahan GA</th>
                            <th>Detail Permasalahan</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="tableReportBody">
                    </tbody>
                </table>
            </div>
            <!-- PAGINATION BAR -->
            <div class="pagination-bar">
                <div class="pagination-info" id="paginationInfo">Showing 0 of 0 reports</div>
                <div class="pagination-btn-group">
                    <button class="pg-btn" id="prevBtn" onclick="changePage(-1)"><i class="fa-solid fa-chevron-left"></i></button>
                    <button class="pg-btn" id="nextBtn" onclick="changePage(1)"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
            </div>
        </div>

        <!-- SECTION CHARTS GA -->
        <div class="section-header">
            <i class="fa-solid fa-chart-simple" style="color: var(--color-ocean-blue);"></i> ANALISTIK & DASHBOARD STATISTIK GA
        </div>
        
        <div class="dashboard-grid">
            <!-- 1. BAR CHART: LAPORAN PER UNIT -->
            <div class="card-box">
                <div class="section-header" style="font-size: 13px; margin-bottom: 14px;">
                    <i class="fa-solid fa-school" style="color: var(--color-ocean-blue);"></i> 1. LAPORAN GA PER UNIT
                </div>
                <div class="chart-container-box">
                    <canvas id="unitBarChart"></canvas>
                </div>
            </div>
            <!-- 2. LINE CHART: TREN LAPORAN -->
            <div class="card-box">
                <div class="section-header" style="font-size: 13px; margin-bottom: 14px;">
                    <i class="fa-solid fa-chart-line" style="color: var(--color-ocean-blue);"></i> 2. TREN LAPORAN GENERAL AFFAIR
                </div>
                <div class="chart-container-box">
                    <canvas id="trendLineChart"></canvas>
                </div>
            </div>
            <!-- 3. DOUGHNUT CHART: PERMASALAHAN GA -->
            <div class="card-box">
                <div>
                    <div class="section-header" style="font-size: 13px; margin-bottom: 14px;">
                        <i class="fa-solid fa-boxes-packing" style="color: var(--color-ocean-blue);"></i> 3. KATEGORI PROBLEM GA
                    </div>
                    <div class="chart-container-box">
                        <canvas id="problemCategoryChart"></canvas>
                        <div class="chart-center-text">
                            <div class="number"><%= totalLaporan %></div>
                            <div class="label">TOTAL TIKET</div>
                        </div>
                    </div>
                </div>
                <div class="chart-legend-container" id="problemChartLegend"></div>
            </div>
            <!-- 4. STATUS BREAKDOWN CHART -->
            <div class="card-box">
                <div>
                    <div class="section-header" style="font-size: 13px; margin-bottom: 14px;">
                        <i class="fa-solid fa-spinner" style="color: var(--color-ocean-blue);"></i> 4. STATUS BREAKDOWN TIKET GA
                    </div>
                    <div class="chart-container-box">
                        <canvas id="statusBreakdownChart"></canvas>
                        <div class="chart-center-text">
                            <div class="number"><%= totalLaporan %></div>
                            <div class="label">TOTAL STATUS</div>
                        </div>
                    </div>
                </div>
                <div class="chart-legend-container" id="statusChartLegend"></div>
            </div>
        </div>

        <!-- TOMBOL ACTION KE FORM GA -->
        <div class="cta-box">
            <a href="/ga/form" class="btn-submit-main">
                <span>AJUKAN PERBAIKAN GA</span>
                <i class="fa-solid fa-arrow-right-long"></i>
            </a>
        </div>
    </main>

    <footer>
        <p>© 2026 PORTAL MAINTENANCE INTERNAL - CENDEKIA MUDA. All rights reserved.</p>
    </footer>

    <script>
        const rawReports = <%- typeof reports !== 'undefined' ? JSON.stringify(reports) : '[]' %>;
        
        const reversedReports = [...rawReports].reverse();
        
        let selectedUnit = '';
        let selectedStatus = '';
        let selectedProblem = '';

        let filteredReports = [...reversedReports];
        let currentPage = 1;
        const rowsPerPage = 10;

        // INITIALIZE CUSTOM DROPDOWNS
        function setupCustomDropdown(wrapperId, onSelectCallback) {
            const wrapper = document.getElementById(wrapperId);
            if (!wrapper) return;
            const trigger = wrapper.querySelector('.custom-select-trigger');
            const options = wrapper.querySelectorAll('.custom-option');

            trigger.addEventListener('click', (e) => {
                e.stopPropagation();
                document.querySelectorAll('.custom-select-wrapper').forEach(w => {
                    if (w !== wrapper) w.classList.remove('open');
                });
                wrapper.classList.toggle('open');
            });

            options.forEach(opt => {
                opt.addEventListener('click', (e) => {
                    e.stopPropagation();
                    options.forEach(o => o.classList.remove('selected'));
                    opt.classList.add('selected');
                    trigger.querySelector('span').innerText = opt.innerText;
                    wrapper.classList.remove('open');
                    onSelectCallback(opt.getAttribute('data-value'));
                });
            });
        }

        document.addEventListener('click', () => {
            document.querySelectorAll('.custom-select-wrapper').forEach(w => w.classList.remove('open'));
        });

        setupCustomDropdown('unitDropdownWrapper', (val) => {
            selectedUnit = val;
            applyFilters();
        });

        setupCustomDropdown('statusDropdownWrapper', (val) => {
            selectedStatus = val;
            applyFilters();
        });

        setupCustomDropdown('problemDropdownWrapper', (val) => {
            selectedProblem = val;
            applyFilters();
        });

        function applyFilters() {
            const unitVal = selectedUnit.toLowerCase();
            const statusVal = selectedStatus.toLowerCase();
            const problemVal = selectedProblem.toLowerCase();
            const keywordVal = document.getElementById('filterKeyword').value.toLowerCase();

            filteredReports = reversedReports.filter(row => {
                const waktu = (row.waktu || row[0] || '').toString().toLowerCase();
                const unit = (row.unit || row[1] || '').toString().toLowerCase();
                const nama = (row.nama || row[2] || '').toString().toLowerCase();
                const permasalahan = (row.permasalahan || row[4] || '').toString().toLowerCase();
                const detail = (row.detail || row[5] || '').toString().toLowerCase();
                const status = (row.status || row[7] || '').toString().toLowerCase();

                const matchUnit = !unitVal || unit === unitVal;
                const matchStatus = !statusVal || status.includes(statusVal);
                const matchProblem = !problemVal || permasalahan.includes(problemVal);
                const matchKeyword = !keywordVal || 
                    waktu.includes(keywordVal) || 
                    unit.includes(keywordVal) || 
                    nama.includes(keywordVal) || 
                    permasalahan.includes(keywordVal) || 
                    detail.includes(keywordVal) || 
                    status.includes(keywordVal);

                return matchUnit && matchStatus && matchProblem && matchKeyword;
            });

            currentPage = 1;
            renderTablePage(currentPage);
        }

        function getStatusBadgeHTML(statusStr) {
            const st = (statusStr || '').toString().trim().toLowerCase();
            if (st.includes('selesai')) {
                return `<span class="badge-status badge-selesai">Selesai</span>`;
            } else if (st.includes('diproses') || st.includes('proses')) {
                return `<span class="badge-status badge-proses">Diproses</span>`;
            } else if (st.includes('pending')) {
                return `<span class="badge-status badge-pending">Pending</span>`;
            } else {
                return `<span class="badge-status badge-acc">Dalam Antrian</span>`;
            }
        }

        function renderTablePage(page) {
            const tbody = document.getElementById('tableReportBody');
            tbody.innerHTML = '';

            if (filteredReports.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: #64748b; padding: 20px;">Belum ada data laporan GA.</td></tr>`;
                document.getElementById('paginationInfo').innerText = `Showing 0 of 0 reports`;
                document.getElementById('prevBtn').disabled = true;
                document.getElementById('nextBtn').disabled = true;
                return;
            }

            const start = (page - 1) * rowsPerPage;
            const end = Math.min(start + rowsPerPage, filteredReports.length);
            const pageData = filteredReports.slice(start, end);

            pageData.forEach(row => {
                const tr = document.createElement('tr');
                const waktu = row.waktu || row[0] || '-';
                const unit = row.unit || row[1] || '-';
                const nama = row.nama || row[2] || '-';
                const permasalahan = row.permasalahan || row[4] || '-';
                const detail = row.detail || row[5] || '-';
                const status = row.status || row[7] || 'Dalam Antrian';

                tr.innerHTML = `
                    <td>${waktu}</td>
                    <td><b>${unit}</b></td>
                    <td>${nama}</td>
                    <td>${permasalahan}</td>
                    <td>${detail}</td>
                    <td>${getStatusBadgeHTML(status)}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('paginationInfo').innerText = `Showing ${start + 1}-${end} of ${filteredReports.length} reports`;
            document.getElementById('prevBtn').disabled = (page === 1);
            document.getElementById('nextBtn').disabled = (end >= filteredReports.length);
        }

        function changePage(direction) {
            currentPage += direction;
            renderTablePage(currentPage);
        }

        renderTablePage(currentPage);

        const unitCounts = {};
        const dateCounts = {};
        const problemCounts = {};
        const statusCounts = {
            'Dalam Antrian': 0,
            'Diproses': 0,
            'Pending': 0,
            'Selesai': 0
        };

        rawReports.forEach(row => {
            const u = row.unit || row[1] || 'Lainnya';
            unitCounts[u] = (unitCounts[u] || 0) + 1;

            const dt = row.waktu || row[0] || 'Unknown';
            const cleanDate = dt.split(',')[0].split(' ')[0] || dt;
            dateCounts[cleanDate] = (dateCounts[cleanDate] || 0) + 1;

            const prob = row.permasalahan || row[4] || 'Lainnya';
            problemCounts[prob] = (problemCounts[prob] || 0) + 1;

            const st = (row.status || row[7] || 'Dalam Antrian').toString().trim();
            if (st.toLowerCase().includes('selesai')) statusCounts['Selesai']++;
            else if (st.toLowerCase().includes('diproses') || st.toLowerCase().includes('proses')) statusCounts['Diproses']++;
            else if (st.toLowerCase().includes('pending')) statusCounts['Pending']++;
            else statusCounts['Dalam Antrian']++;
        });

        // CHARTS GA
        const ctxBar = document.getElementById('unitBarChart').getContext('2d');
        const barGrad = ctxBar.createLinearGradient(0, 0, 0, 180);
        barGrad.addColorStop(0, '#074173');
        barGrad.addColorStop(1, '#1679AB');

        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: Object.keys(unitCounts).length ? Object.keys(unitCounts) : ['SD Makasar', 'SMP', 'Daycare'],
                datasets: [{
                    label: 'Jumlah Keluhan GA',
                    data: Object.keys(unitCounts).length ? Object.values(unitCounts) : [0, 0, 0],
                    backgroundColor: barGrad,
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 11 } } },
                    y: { grid: { color: '#e2e8f0' }, ticks: { color: '#64748b', font: { size: 10 }, stepSize: 1 }, beginAtZero: true }
                }
            }
        });

        const ctxLine = document.getElementById('trendLineChart').getContext('2d');
        const lineGrad = ctxLine.createLinearGradient(0, 0, 0, 180);
        lineGrad.addColorStop(0, 'rgba(93, 235, 215, 0.45)');
        lineGrad.addColorStop(1, 'rgba(93, 235, 215, 0.0)');

        new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: Object.keys(dateCounts).length ? Object.keys(dateCounts) : ['Hari Ini'],
                datasets: [{
                    label: 'Tren Laporan GA',
                    data: Object.keys(dateCounts).length ? Object.values(dateCounts) : [0],
                    borderColor: '#1679AB',
                    borderWidth: 3,
                    backgroundColor: lineGrad,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#074173',
                    pointBorderColor: '#5DEBD7',
                    pointBorderWidth: 2,
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10 } } },
                    y: { grid: { color: '#e2e8f0' }, ticks: { color: '#64748b', font: { size: 10 }, stepSize: 1 }, beginAtZero: true }
                }
            }
        });

        const problemPalette = [
            '#074173', '#0F5B8E', '#1679AB', '#2095C2', '#32B8C6', '#5DEBD7', '#89F2B4', '#C5FF95', '#64748b'
        ];
        const problemLabels = Object.keys(problemCounts).length ? Object.keys(problemCounts) : ['Tidak Ada Data'];
        const problemData = Object.keys(problemCounts).length ? Object.values(problemCounts) : [1];

        const ctxProblem = document.getElementById('problemCategoryChart').getContext('2d');
        new Chart(ctxProblem, {
            type: 'doughnut',
            data: {
                labels: problemLabels,
                datasets: [{
                    data: problemData,
                    backgroundColor: problemPalette.slice(0, problemLabels.length),
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: { legend: { display: false } }
            }
        });

        const problemLegendContainer = document.getElementById('problemChartLegend');
        problemLabels.forEach((label, idx) => {
            const item = document.createElement('div');
            item.className = 'legend-item';
            item.innerHTML = `
                <div class="legend-color-box" style="background-color: ${problemPalette[idx % problemPalette.length]}"></div>
                <span>${label} (${problemData[idx]})</span>
            `;
            problemLegendContainer.appendChild(item);
        });

        const statusLabels = ['Dalam Antrian', 'Diproses', 'Pending', 'Selesai'];
        const statusData = [
            statusCounts['Dalam Antrian'],
            statusCounts['Diproses'],
            statusCounts['Pending'],
            statusCounts['Selesai']
        ];
        const statusPalette = ['#94a3b8', '#0284c7', '#ef4444', '#22c55e'];

        const ctxStatus = document.getElementById('statusBreakdownChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusData,
                    backgroundColor: statusPalette,
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: { legend: { display: false } }
            }
        });

        const statusLegendContainer = document.getElementById('statusChartLegend');
        statusLabels.forEach((label, idx) => {
            const item = document.createElement('div');
            item.className = 'legend-item';
            item.innerHTML = `
                <div class="legend-color-box" style="background-color: ${statusPalette[idx]}"></div>
                <span>${label} (${statusData[idx]})</span>
            `;
            statusLegendContainer.appendChild(item);
        });

        /* CANVAS ANIMATION HERO (GEARS & FLOATING PARTICLES) */
        const canvas = document.getElementById('ga-animation-canvas');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let particles = [];
            let gears = [];

            function resizeCanvas() {
                canvas.width = canvas.parentElement.offsetWidth;
                canvas.height = canvas.parentElement.offsetHeight;
            }
            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();

            class Particle {
                constructor() { this.reset(); }
                reset() {
                    this.x = Math.random() * canvas.width;
                    this.y = Math.random() * canvas.height;
                    this.size = Math.random() * 3 + 1;
                    this.speedX = (Math.random() - 0.5) * 0.5;
                    this.speedY = (Math.random() - 0.5) * 0.5;
                    this.opacity = Math.random() * 0.5 + 0.2;
                }
                update() {
                    this.x += this.speedX;
                    this.y += this.speedY;
                    if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) {
                        this.reset();
                    }
                }
                draw() {
                    ctx.fillStyle = `rgba(93, 235, 215, ${this.opacity})`;
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                    ctx.fill();
                }
            }

            class Gear {
                constructor() { this.reset(); }
                reset() {
                    this.x = Math.random() * canvas.width;
                    this.y = Math.random() * canvas.height;
                    this.radius = Math.random() * 18 + 12;
                    this.teeth = Math.floor(Math.random() * 3) + 6;
                    this.speedX = (Math.random() - 0.5) * 0.3;
                    this.speedY = (Math.random() - 0.5) * 0.3;
                    this.angle = Math.random() * Math.PI * 2;
                    this.rotSpeed = (Math.random() - 0.5) * 0.02;
                    this.opacity = Math.random() * 0.25 + 0.1;
                }
                update() {
                    this.x += this.speedX;
                    this.y += this.speedY;
                    this.angle += this.rotSpeed;
                    if (this.x < -40 || this.x > canvas.width + 40 || this.y < -40 || this.y > canvas.height + 40) {
                        this.reset();
                    }
                }
                draw() {
                    ctx.save();
                    ctx.translate(this.x, this.y);
                    ctx.rotate(this.angle);
                    ctx.fillStyle = `rgba(93, 235, 215, ${this.opacity})`;
                    ctx.strokeStyle = `rgba(197, 255, 149, ${this.opacity})`;
                    ctx.lineWidth = 1.2;
                    ctx.beginPath();

                    const outerR = this.radius;
                    const innerR = this.radius * 0.75;
                    const holeR = this.radius * 0.3;
                    const numTeeth = this.teeth;

                    for (let i = 0; i < numTeeth; i++) {
                        const a1 = (i * 2 * Math.PI) / numTeeth;
                        const a2 = a1 + Math.PI / numTeeth / 2;
                        const a3 = a1 + Math.PI / numTeeth;
                        const a4 = a1 + (1.5 * Math.PI) / numTeeth;

                        if (i === 0) ctx.moveTo(outerR * Math.cos(a1), outerR * Math.sin(a1));
                        else ctx.lineTo(outerR * Math.cos(a1), outerR * Math.sin(a1));

                        ctx.lineTo(outerR * Math.cos(a2), outerR * Math.sin(a2));
                        ctx.lineTo(innerR * Math.cos(a3), innerR * Math.sin(a3));
                        ctx.lineTo(innerR * Math.cos(a4), innerR * Math.sin(a4));
                    }
                    ctx.closePath();
                    ctx.fill();
                    ctx.stroke();

                    ctx.beginPath();
                    ctx.arc(0, 0, holeR, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(7, 48, 85, 0.5)';
                    ctx.fill();
                    ctx.stroke();

                    ctx.restore();
                }
            }

            for (let i = 0; i < 35; i++) particles.push(new Particle());
            for (let j = 0; j < 12; j++) gears.push(new Gear());

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                particles.forEach(p => { p.update(); p.draw(); });
                gears.forEach(g => { g.update(); g.draw(); });
                requestAnimationFrame(animate);
            }
            animate();
        }
    </script>
</body>
</html>