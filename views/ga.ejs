<div class="hero-container">
  <div style="display: flex; justify-content: center; align-items: center">
    <div
      style="
        width: 100%;
        max-width: 580px;
        border-radius: 20px;
        overflow: hidden;
        background: var(--color-muted-blue);
        border: 1px solid var(--color-purple);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        padding: 30px;
      "
    >
      <h2
        style="color: var(--color-pink); margin-bottom: 20px; font-size: 22px"
      >
        <i class="fa-solid fa-clipboard-list" style="margin-right: 8px"></i>Form
        Request Fasilitas GA
      </h2>

      <form id="gaForm" onsubmit="submitToGaSheet(event)">
        <div style="margin-bottom: 15px; text-align: left">
          <label
            style="
              font-size: 13px;
              color: var(--text-muted);
              display: block;
              margin-bottom: 5px;
            "
            >Nama Pemohon / Unit:</label
          >
          <input
            type="text"
            name="nama"
            required
            style="
              width: 100%;
              padding: 10px;
              border-radius: 8px;
              border: 1px solid var(--color-purple);
              background: var(--color-dark);
              color: white;
            "
          />
        </div>
        <div style="margin-bottom: 15px; text-align: left">
          <label
            style="
              font-size: 13px;
              color: var(--text-muted);
              display: block;
              margin-bottom: 5px;
            "
            >Fasilitas / Barang yang Direquest:</label
          >
          <textarea
            name="kendala"
            rows="3"
            required
            style="
              width: 100%;
              padding: 10px;
              border-radius: 8px;
              border: 1px solid var(--color-purple);
              background: var(--color-dark);
              color: white;
            "
          ></textarea>
        </div>
        <button
          type="submit"
          class="btn-pink"
          style="width: 100%; justify-content: center"
        >
          Kirim Request
        </button>
      </form>
      <p
        id="gaStatusMessage"
        style="margin-top: 15px; font-size: 13px; text-align: center"
      ></p>
    </div>
  </div>

  <div style="text-align: left">
    <div>
      <h1>LAYANAN FASILITAS</h1>
      <p class="sub-title">CENDEKIA MUDA</p>
      <p class="description" style="margin-left: 0; margin-right: auto">
        Siap mengelola sarana, prasarana, dan operasional lingkungan sekolah
        dengan amanah dan profesional.
      </p>
    </div>
  </div>
</div>

<script>
  async function submitToGaSheet(event) {
    event.preventDefault();
    const form = document.getElementById("gaForm");
    const status = document.getElementById("gaStatusMessage");
    const formData = new FormData(form);

    formData.append("kategori", "General Affair");

    status.style.color = "var(--color-pink)";
    status.innerText = "Mengirim data...";

    const WEB_APP_URL = "MASUKKAN_URL_GOOGLE_APPS_SCRIPT_DISINI";

    try {
      await fetch(WEB_APP_URL, {
        method: "POST",
        mode: "no-cors",
        body: formData,
      });
      status.style.color = "#4ade80";
      status.innerText = "Berhasil! Data terkirim ke Spreadsheet.";
      form.reset();
    } catch (error) {
      status.style.color = "#f87171";
      status.innerText = "Gagal mengirim data. Coba lagi.";
    }
  }
</script>
