<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GA (General Affair) - Cendekia Muda</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --bg-light: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --color-dark-blue: #074173;
            --color-ocean-blue: #1679AB;
            --color-cyan-mint: #5DEBD7;
            --color-lime-green: #C5FF95;
            --text-main: #074173;
            --text-muted: #64748b;
        }

        * { 
            box-sizing: border-box; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
        }

        body {
            background-color: var(--bg-light);
            color: var(--text-main);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* HEADER & NAVIGATION */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 50px;
            background: #074173;
            border-bottom: 1px solid rgba(93, 235, 215, 0.2);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
            box-shadow: 0 2px 16px rgba(7, 65, 115, 0.3);
        }

        .logo-container { 
            display: flex; 
            align-items: center; 
            gap: 12px; 
        }

        .logo-img { 
            height: 32px; 
            width: auto; 
            display: block; 
            object-fit: contain; 
        }

        .logo-divider { 
            width: 1px; 
            height: 22px; 
            background-color: rgba(255,255,255,0.2); 
        }

        .logo-sub { 
            font-size: 17px; 
            color: var(--color-cyan-mint); 
            letter-spacing: 2px; 
            font-weight: 700; 
            text-transform: uppercase; 
        }

        nav { 
            display: flex; 
            align-items: center; 
            gap: 28px; 
        }

        nav a { 
            color: rgba(255,255,255,0.75); 
            text-decoration: none; 
            font-size: 16px; 
            font-weight: 600; 
            letter-spacing: 0.5px; 
            position: relative; 
            padding: 4px 0; 
        }

        nav a:hover, nav a.active { 
            color: #ffffff; 
        }

        nav a.active::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--color-cyan-mint), var(--color-lime-green));
            border-radius: 2px;
        }

        /* HERO BANNER */
        .hero {
            position: relative;
            padding: 130px 20px 170px 20px; 
            min-height: 520px; 
            text-align: center;
            background: 
                linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.12) 1px, transparent 1px),
                linear-gradient(135deg, rgba(22, 121, 171, 0.88) 0%, rgba(7, 65, 115, 0.95) 100%),
                url('https://images.unsplash.com/photo-1497366216548-37526070297c?w=1600&q=80') center/cover no-repeat;
            background-size: 35px 35px, 35px 35px, cover, cover;
            color: #ffffff;
            overflow: visible;
        }

        #ga-animation-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
        }

        .hero-inner {
            position: relative;
            z-index: 2;
            max-width: 850px;
            margin: 0 auto;
        }

        .badge-capsule {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 20px;
            border-radius: 30px;
            background: rgba(197, 255, 149, 0.15);
            border: 1px solid #C5FF95;
            color: #C5FF95;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 24px;
            backdrop-filter: blur(8px);
        }

        .badge-capsule .dot-pulse {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #C5FF95;
            box-shadow: 0 0 10px #C5FF95;
            animation: pulseGlow 1.5s infinite;
        }

        .hero h1 { 
            font-size: 48px; 
            font-weight: 900; 
            margin: 0 0 6px 0; 
            letter-spacing: 2px; 
            color: #ffffff; 
            text-transform: uppercase;
            text-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .hero .subtitle { 
            font-size: 32px; 
            color: #C5FF95; 
            font-weight: 900; 
            letter-spacing: 2px; 
            margin-bottom: 20px; 
            text-transform: uppercase;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        }

        .hero p { 
            color: rgba(255, 255, 255, 0.95); 
            font-size: 14px; 
            max-width: 680px; 
            margin: 0 auto; 
            line-height: 1.6; 
        }

        .hero-stats-card {
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translate(-50%, 50%);
            z-index: 20;
            width: 90%;
            max-width: 850px;
            background: #ffffff;
            border: 1.5px solid #5DEBD7;
            border-radius: 20px;
            padding: 28px 30px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            box-shadow: 0 20px 45px rgba(7, 65, 115, 0.2);
        }

        .stat-item {
            text-align: center;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .stat-item:not(:last-child)::after {
            content: "";
            position: absolute;
            right: 0;
            top: 15%;
            height: 70%;
            width: 1px;
            background: #e2e8f0;
        }

        .stat-number {
            font-size: 36px;
            font-weight: 900;
            color: #074173; 
            margin-bottom: 6px;
            line-height: 1.1;
            display: block;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 800;
            color: #1679AB;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            display: block;
        }

        /* CONTAINER */
        .container { 
            max-width: 1100px; 
            margin: 110px auto 0 auto; 
            padding: 10px 24px 70px 24px; 
            width: 100%; 
        }

        .section-header {
            font-size: 15px;
            font-weight: 800;
            color: var(--color-dark-blue);
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 24px;
            margin-bottom: 45px;
        }

        .team-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 22px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
            cursor: pointer;
        }

        .team-card:hover {
            transform: translateY(-8px) scale(1.01);
            border-color: var(--color-ocean-blue);
            box-shadow: 0 15px 30px rgba(22, 121, 171, 0.15);
        }

        .team-body { 
            display: flex; 
            align-items: center; 
            gap: 18px; 
            margin-bottom: 16px; 
        }

        .avatar-wrapper {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, var(--color-ocean-blue), var(--color-cyan-mint));
            flex-shrink: 0;
        }

        .avatar-wrapper img { 
            width: 100%; 
            height: 100%; 
            border-radius: 50%; 
            object-fit: cover; 
            background-color: #f1f5f9; 
        }

        .team-info h3 { 
            margin: 0; 
            font-size: 17px; 
            font-weight: 800; 
            color: var(--color-dark-blue); 
            letter-spacing: 0.5px; 
        }

        .team-info .role-badge {
            display: inline-block;
            background: rgba(22, 121, 171, 0.1);
            color: var(--color-ocean-blue);
            font-size: 10px;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 6px;
            margin: 6px 0 8px 0;
            letter-spacing: 0.8px;
        }

        .contact-list { 
            font-size: 11px; 
            color: var(--text-muted); 
            display: flex; 
            flex-direction: column; 
            gap: 4px; 
        }

        .btn-contact {
            background-color: #f1f5f9;
            border: 1px solid var(--border-color);
            color: var(--color-dark-blue);
            font-size: 12px;
            font-weight: 700;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            text-decoration: none;
        }

        .team-card:hover .btn-contact { 
            background-color: var(--color-ocean-blue); 
            color: #ffffff; 
            border-color: var(--color-ocean-blue); 
        }

        .cta-box { 
            text-align: center; 
            margin-top: 20px; 
        }

        .btn-submit-main {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: var(--color-dark-blue);
            color: #ffffff;
            font-weight: 800;
            font-size: 15px;
            letter-spacing: 1px;
            padding: 18px 42px;
            border-radius: 16px;
            text-decoration: none;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.25);
        }

        .btn-submit-main:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 15px 30px rgba(22, 121, 171, 0.35);
            background: var(--color-ocean-blue);
        }

        footer { 
            background-color: #ffffff; 
            padding: 24px; 
            text-align: center; 
            font-size: 12px; 
            color: var(--text-muted); 
            border-top: 1px solid var(--border-color); 
            margin-top: auto; 
        }

        /* MEDIA QUERIES */
        @media (max-width: 768px) {
            header { padding: 16px 20px; }
            .hero h1 { font-size: 32px; }
            .hero .subtitle { font-size: 22px; }
            .hero-stats-card { grid-template-columns: 1fr; margin-bottom: -120px; gap: 15px; }
            .stat-item:not(:last-child)::after { display: none; }
            .container { margin-top: 140px; }
        }

        /* ANIMATIONS */
        @keyframes pulseGlow {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 255, 149, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(197, 255, 149, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 255, 149, 0); }
        }

        @keyframes fadeDown {
            from { opacity: 0; transform: translateY(-24px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(32px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeLeft {
            from { opacity: 0; transform: translateX(-24px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        @keyframes rotateBorder {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }

        @keyframes pulseShadow {
            0%, 100% { box-shadow: 0 10px 25px rgba(7,65,115,0.25); }
            50%      { box-shadow: 0 10px 35px rgba(93,235,215,0.45), 0 0 0 6px rgba(93,235,215,0.1); }
        }

        .hero h1        { animation: fadeDown 0.7s 0.1s ease both; }
        .hero .subtitle { animation: fadeDown 0.7s 0.25s ease both; }
        .hero p         { animation: fadeDown 0.7s 0.4s ease both; }
        .section-header { animation: fadeLeft 0.6s 0.2s ease both; }

        .anim-reveal { animation: fadeUp 0.6s ease both; animation-play-state: paused; }
        .anim-reveal.visible { animation-play-state: running; }

        .avatar-wrapper::before {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            background: conic-gradient(var(--color-cyan-mint), var(--color-lime-green), var(--color-ocean-blue), var(--color-cyan-mint));
            animation: rotateBorder 3s linear infinite;
            z-index: 0;
        }

        .avatar-wrapper img { position: relative; z-index: 1; }
        .btn-submit-main { animation: pulseShadow 2.5s ease-in-out infinite; }
        .btn-submit-main:hover { animation: none; }
    </style>
</head>
<body>

    <header>
        <div class="logo-container">
            <img src="/images/logo-kcm.png" alt="Logo KCM" class="logo-img">
            <div class="logo-divider"></div>
            <div class="logo-sub">IT Support & General Affair</div>
        </div>
        <nav>
            <a href="/">Home</a>
            <a href="/it-support">IT Support</a>
            <a href="/ga" class="active">GA (General Affair)</a>
            <a href="/about">About Us</a>
        </nav>
    </header>

    <div class="hero">
        <canvas id="ga-animation-canvas"></canvas>
        <div class="hero-inner">
            <div class="badge-capsule">
                <div class="dot-pulse"></div> GA & FACILITY OPERATIONS CENTER
            </div>
            <h1>LAYANAN FASILITAS</h1>
            <div class="subtitle">CENDEKIA MUDA</div>
            <p>Pusat Pengelolaan Sarana, Prasarana, Kelistrikan, AC, & Operasional Gedung Terpadu. Siap Mengatasi Kendala Fasilitas dengan Cepat, Amanah, dan Profesional.</p>
        </div>

        <div class="hero-stats-card">
            <div class="stat-item">
                <span class="stat-number">30 Menit</span>
                <span class="stat-label">SLA Penanganan GA</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">850+</span>
                <span class="stat-label">Fasilitas Terawat</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">99.5%</span>
                <span class="stat-label">Gedung Siap Pakai</span>
            </div>
        </div>
    </div>

    <main class="container">
        <div class="section-header">
            <i class="fa-solid fa-users-gear" style="color: var(--color-ocean-blue);"></i> TIM GENERAL AFFAIR / PIC
        </div>
        <div class="team-grid">
            <div class="team-card">
                <div class="team-body">
                    <div class="avatar-wrapper">
                        <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=150&auto=format&fit=crop&q=80" alt="PIC GA 1">
                    </div>
                    <div class="team-info">
                        <h3>NAMA PIC GA 1</h3>
                        <div class="role-badge">TIM GENERAL AFFAIR</div>
                        <div class="contact-list">
                            <span><i class="fa-solid fa-phone" style="width: 14px;"></i> Ext: 201</span>
                            <span><i class="fa-brands fa-whatsapp" style="width: 14px;"></i> WA: 0812-xxxx-xxxx</span>
                        </div>
                    </div>
                </div>
                <a href="https://wa.me/" target="_blank" class="btn-contact">Hubungi PIC</a>
            </div>

            <div class="team-card">
                <div class="team-body">
                    <div class="avatar-wrapper">
                        <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=150&auto=format&fit=crop&q=80" alt="PIC GA 2">
                    </div>
                    <div class="team-info">
                        <h3>NAMA PIC GA 2</h3>
                        <div class="role-badge">SPESIALIS SARANA & PRASARANA</div>
                        <div class="contact-list">
                            <span><i class="fa-solid fa-phone" style="width: 14px;"></i> Ext: 202</span>
                            <span><i class="fa-brands fa-whatsapp" style="width: 14px;"></i> WA: 0813-xxxx-xxxx</span>
                        </div>
                    </div>
                </div>
                <a href="https://wa.me/" target="_blank" class="btn-contact">Hubungi PIC</a>
            </div>
        </div>

        <div class="cta-box">
            <a href="/ga/form" class="btn-submit-main">
                <span>AJUKAN REQUEST FASILITAS GA</span>
                <i class="fa-solid fa-arrow-right-long"></i>
            </a>
        </div>
    </main>

    <footer>
        <p>© 2026 PORTAL MAINTENANCE INTERNAL - CENDEKIA MUDA. All rights reserved.</p>
    </footer>

    <script>
        const canvas = document.getElementById('ga-animation-canvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        /* ANIMASI GA: ROTATING GEARS & FLOATING PARTICLES */
        const gears = [
            { x: 0.12, y: 0.25, radius: 45, teeth: 8, angle: 0, speed: 0.005, color: 'rgba(93, 235, 215, 0.25)' },
            { x: 0.88, y: 0.35, radius: 60, teeth: 12, angle: 0, speed: -0.003, color: 'rgba(197, 255, 149, 0.2)' },
            { x: 0.82, y: 0.70, radius: 35, teeth: 8, angle: 0, speed: 0.006, color: 'rgba(93, 235, 215, 0.2)' }
        ];

        const particles = [];
        for (let i = 0; i < 20; i++) {
            particles.push({
                x: Math.random(),
                y: Math.random(),
                size: Math.random() * 3 + 1,
                speedY: -(Math.random() * 0.4 + 0.1),
                opacity: Math.random() * 0.5 + 0.2
            });
        }

        function drawGear(cx, cy, radius, teeth, angle, color) {
            ctx.save();
            ctx.beginPath();
            ctx.translate(cx, cy);
            ctx.rotate(angle);
            ctx.fillStyle = color;

            const outerRadius = radius;
            const innerRadius = radius * 0.75;
            const holeRadius = radius * 0.3;

            for (let i = 0; i < teeth; i++) {
                const alpha = (Math.PI * 2 / teeth) * i;
                const alphaNext = (Math.PI * 2 / teeth) * (i + 0.5);

                const x1 = Math.cos(alpha) * innerRadius;
                const y1 = Math.sin(alpha) * innerRadius;
                const x2 = Math.cos(alpha) * outerRadius;
                const y2 = Math.sin(alpha) * outerRadius;
                const x3 = Math.cos(alphaNext) * outerRadius;
                const y3 = Math.sin(alphaNext) * outerRadius;
                const x4 = Math.cos(alphaNext) * innerRadius;
                const y4 = Math.sin(alphaNext) * innerRadius;

                if (i === 0) ctx.moveTo(x1, y1);
                else ctx.lineTo(x1, y1);

                ctx.lineTo(x2, y2);
                ctx.lineTo(x3, y3);
                ctx.lineTo(x4, y4);
            }
            ctx.closePath();
            ctx.fill();

            /* Lubang Tengah Gear */
            ctx.beginPath();
            ctx.arc(0, 0, holeRadius, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(7, 65, 115, 0.6)';
            ctx.fill();
            ctx.restore();
        }

        function animateGA() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            /* 1. Gambar Gerigi (Gears) GA */
            gears.forEach(g => {
                g.angle += g.speed;
                const posX = g.x * canvas.width;
                const posY = g.y * canvas.height;
                drawGear(posX, posY, g.radius, g.teeth, g.angle, g.color);
            });

            /* 2. Floating Particles GA */
            particles.forEach(p => {
                p.y += p.speedY / canvas.height;
                if (p.y < 0) {
                    p.y = 1;
                    p.x = Math.random();
                }
                ctx.fillStyle = `rgba(197, 255, 149, ${p.opacity})`;
                ctx.beginPath();
                ctx.arc(p.x * canvas.width, p.y * canvas.height, p.size, 0, Math.PI * 2);
                ctx.fill();
            });

            requestAnimationFrame(animateGA);
        }
        animateGA();

        /* INTERSECTION OBSERVER ANIMATION */
        const revealEls = document.querySelectorAll('.team-card, .cta-box');
        revealEls.forEach(el => el.classList.add('anim-reveal'));

        const observer = new IntersectionObserver(entries => {
            entries.forEach((e, i) => {
                if (e.isIntersecting) {
                    setTimeout(() => e.target.classList.add('visible'), i * 120);
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.12 });

        revealEls.forEach(el => observer.observe(el));
    </script>
</body>
</html>