            </div>
            <!-- 3. DOUGHNUT CHART: PERMASALAHAN GA -->
            <div class="card-box">
                <div>
                    <div class="section-header" style="font-size: 13px; margin-bottom: 14px;">
                        <i class="fa-solid fa-boxes-packing" style="color: var(--color-ocean-blue);"></i> 3. KATEGORI PROBLEM GA
                    </div>
                    <div class="chart-container-box">
                        <canvas id="problemCategoryChart"></canvas>
                        <div class="chart-center-text">
                            <div class="number"><%= totalLaporan %></div>
