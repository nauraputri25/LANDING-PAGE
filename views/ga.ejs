                            <span class="badge-priority">PRIORITY</span>
                        </div>
                        <span class="ticket-pic"><i class="fa-solid fa-user-gear"></i> PIC: Nama PIC GA 1</span>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" style="width: 40%;"></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="cta-box">
            <a href="/ga/form" class="btn-submit-main">
                <span>AJUKAN REQUEST FASILITAS GA</span>
                <i class="fa-solid fa-arrow-right-long"></i>
            </a>
        </div>
    </main>

    <footer>
        <p>© 2026 PORTAL MAINTENANCE INTERNAL - CENDEKIA MUDA. All rights reserved.</p>
    </footer>

<script>
// Chart Configuration
        const chartCtx = document.getElementById('damageChart').getContext('2d');
        new Chart(chartCtx, {
            type: 'doughnut',
            data: {
                labels: ['Listrik & AC', 'Sarana Prasarana', 'Kebersihan & Lainnya'],
                datasets: [{
                    data: [40, 35, 25],
                    backgroundColor: ['#074173', '#1679AB', '#5DEBD7'],
                    borderWidth: 0,
                    hoverOffset: 12
                }]
            },
            options: {
                cutout: '72%',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#074173',
                        titleColor: '#ffffff',
                        bodyColor: '#5DEBD7',
                        borderColor: '#e2e8f0',
                        borderWidth: 1,
                        padding: 12,
                        callbacks: {
                            label: function(context) {
                                return ` ${context.label}: ${context.raw}%`;
                            }
                        }
                    }
                }
            }
        });

        const canvas = document.getElementById('ga-animation-canvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        /* ANIMASI GA: ROTATING GEARS & FLOATING PARTICLES */
        const gears = [
            { x: 0.12, y: 0.25, radius: 45, teeth: 8, angle: 0, speed: 0.005, color: 'rgba(93, 235, 215, 0.25)' },
            { x: 0.88, y: 0.35, radius: 60, teeth: 12, angle: 0, speed: -0.003, color: 'rgba(197, 255, 149, 0.2)' },
            { x: 0.82, y: 0.70, radius: 35, teeth: 8, angle: 0, speed: 0.006, color: 'rgba(93, 235, 215, 0.2)' }
        ];

        const particles = [];
        for (let i = 0; i < 20; i++) {
            particles.push({
                x: Math.random(),
                y: Math.random(),
                size: Math.random() * 3 + 1,
                speedY: -(Math.random() * 0.4 + 0.1),
                opacity: Math.random() * 0.5 + 0.2
            });
        }

        function drawGear(cx, cy, radius, teeth, angle, color) {
            ctx.save();
            ctx.beginPath();
            ctx.translate(cx, cy);
            ctx.rotate(angle);
            ctx.fillStyle = color;

            const outerRadius = radius;
            const innerRadius = radius * 0.75;
            const holeRadius = radius * 0.3;

            for (let i = 0; i < teeth; i++) {
                const alpha = (Math.PI * 2 / teeth) * i;
                const alphaNext = (Math.PI * 2 / teeth) * (i + 0.5);

                const x1 = Math.cos(alpha) * innerRadius;
                const y1 = Math.sin(alpha) * innerRadius;
                const x2 = Math.cos(alpha) * outerRadius;
                const y2 = Math.sin(alpha) * outerRadius;
                const x3 = Math.cos(alphaNext) * outerRadius;
                const y3 = Math.sin(alphaNext) * outerRadius;
                const x4 = Math.cos(alphaNext) * innerRadius;
                const y4 = Math.sin(alphaNext) * innerRadius;

                if (i === 0) ctx.moveTo(x1, y1);
                else ctx.lineTo(x1, y1);

                ctx.lineTo(x2, y2);
                ctx.lineTo(x3, y3);
                ctx.lineTo(x4, y4);
            }
            ctx.closePath();
            ctx.fill();

            /* Lubang Tengah Gear */
            ctx.beginPath();
            ctx.arc(0, 0, holeRadius, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(7, 65, 115, 0.6)';
            ctx.fill();
            ctx.restore();
        }

        function animateGA() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            /* 1. Gambar Gerigi (Gears) GA */
            gears.forEach(g => {
                g.angle += g.speed;
                const posX = g.x * canvas.width;
                const posY = g.y * canvas.height;
                drawGear(posX, posY, g.radius, g.teeth, g.angle, g.color);
            });

            /* 2. Floating Particles GA */
            particles.forEach(p => {
                p.y += p.speedY / canvas.height;
                if (p.y < 0) {
                    p.y = 1;
                    p.x = Math.random();
                }
                ctx.fillStyle = `rgba(197, 255, 149, ${p.opacity})`;
                ctx.beginPath();
                ctx.arc(p.x * canvas.width, p.y * canvas.height, p.size, 0, Math.PI * 2);
                ctx.fill();
            });

            requestAnimationFrame(animateGA);
        }
        animateGA();

/* INTERSECTION OBSERVER ANIMATION */
        const revealEls = document.querySelectorAll('.team-card, .card-box, .cta-box');
        revealEls.forEach(el => el.classList.add('anim-reveal'));

        const observer = new IntersectionObserver(entries => {
            entries.forEach((e, i) => {
                if (e.isIntersecting) {
                    setTimeout(() => e.target.classList.add('visible'), i * 100);
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.1 });

        revealEls.forEach(el => observer.observe(el));

        // Ticket Items Stagger Animation
        const ticketObserver = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    const items = e.target.querySelectorAll('.ticket-item');
                    items.forEach((item, i) => setTimeout(() => item.classList.add('visible'), i * 120));
                    ticketObserver.unobserve(e.target);
                }
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.ticket-list').forEach(el => ticketObserver.observe(el));
    </script>
</body>
</html>