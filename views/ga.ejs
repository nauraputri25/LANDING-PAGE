<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GA (General Affair) - Cendekia Muda</title>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-light: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --color-dark-blue: #074173;
            --color-ocean-blue: #1679AB;
            --color-cyan-mint: #5DEBD7;
            --color-lime-green: #C5FF95;
            --text-main: #074173;
            --text-muted: #64748b;
        }

        * { 
            box-sizing: border-box; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
        }

        body {
            background-color: var(--bg-light);
            color: var(--text-main);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* HEADER & NAVIGATION */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 50px;
            background: #074173;
            border-bottom: 1px solid rgba(93, 235, 215, 0.2);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
            box-shadow: 0 2px 16px rgba(7, 65, 115, 0.3);
        }

        .logo-container { 
            display: flex; 
            align-items: center; 
            gap: 12px; 
        }

        .logo-img { 
            height: 32px; 
            width: auto; 
            display: block; 
            object-fit: contain; 
        }

        .logo-divider { 
            width: 1px; 
            height: 22px; 
            background-color: rgba(255,255,255,0.2); 
        }

        .logo-sub { 
            font-size: 17px; 
            color: var(--color-cyan-mint); 
            letter-spacing: 2px; 
            font-weight: 700; 
            text-transform: uppercase; 
        }

        nav { 
            display: flex; 
            align-items: center; 
            gap: 28px; 
        }

        nav a { 
            color: rgba(255,255,255,0.75); 
            text-decoration: none; 
            font-size: 16px; 
            font-weight: 600; 
            letter-spacing: 0.5px; 
            position: relative; 
            padding: 4px 0; 
        }

        nav a:hover, nav a.active { 
            color: #ffffff; 
        }

        nav a.active::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--color-cyan-mint), var(--color-lime-green));
            border-radius: 2px;
        }

        /* HERO BANNER */
        .hero {
            position: relative;
            padding: 130px 20px 170px 20px; 
            min-height: 520px; 
            text-align: center;
            background: 
                linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.12) 1px, transparent 1px),
                linear-gradient(135deg, rgba(22, 121, 171, 0.88) 0%, rgba(7, 65, 115, 0.95) 100%),
                url('https://images.unsplash.com/photo-1497366216548-37526070297c?w=1600&q=80') center/cover no-repeat;
            background-size: 35px 35px, 35px 35px, cover, cover;
            color: #ffffff;
            overflow: visible;
        }

        #ga-animation-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
        }

        .hero-inner {
            position: relative;
            z-index: 2;
            max-width: 850px;
            margin: 0 auto;
        }

        .badge-capsule {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 20px;
            border-radius: 30px;
            background: rgba(197, 255, 149, 0.15);
            border: 1px solid #C5FF95;
            color: #C5FF95;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 24px;
            backdrop-filter: blur(8px);
        }

        .badge-capsule .dot-pulse {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #C5FF95;
            box-shadow: 0 0 10px #C5FF95;
            animation: pulseGlow 1.5s infinite;
        }

        .hero h1 {
            font-size: clamp(2.4rem, 5.5vw, 4rem);
            font-weight: 900;
            margin: 0 0 10px 0;
            letter-spacing: -0.02em;
            line-height: 1.1;
            background: linear-gradient(135deg, #ffffff 0%, #d0eaf8 60%, #90d0f5 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }

        .hero .subtitle {
            font-size: clamp(1.4rem, 3.2vw, 2.5rem);
            background: linear-gradient(135deg, var(--color-cyan-mint) 0%, #82f3e5 50%, var(--color-lime-green) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            font-weight: 900;
            letter-spacing: 1.5px;
            margin-bottom: 20px;
            filter: drop-shadow(0 0 18px rgba(93,235,215,0.35));
        }

        .hero p {
            color: rgba(255,255,255,0.88);
            font-size: 1rem;
            max-width: 640px;
            margin: 0 auto;
            line-height: 1.7;
        }

        /* FLOATING STATS BAR */
        .hero-stats-wrapper {
            position: relative;
            z-index: 10;
            max-width: 800px;
            margin: -60px auto 40px auto; 
            padding: 0 20px;
            width: 100%;
        }
        .hero-stats {
            display: flex; 
            justify-content: space-around;
            align-items: center;
            background: rgba(6, 28, 54, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(93, 235, 215, 0.25);
            border-radius: 16px;
            padding: 24px 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(93, 235, 215, 0.1);
        }
        .stat-item {
            flex: 1; text-align: center;
            padding: 0 15px;
            position: relative;
        }
        .stat-item:not(:last-child)::after {
            content: '';
            position: absolute;
            right: 0; top: 15%; bottom: 15%;
            width: 1px;
            background: linear-gradient(to bottom, transparent, rgba(93, 235, 215, 0.3), transparent);
        }
        .stat-num {
            font-size: clamp(1.6rem, 2.5vw, 2.2rem); 
            font-weight: 900; 
            line-height: 1;
            background: linear-gradient(135deg, #ffffff 20%, var(--color-cyan-mint) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .stat-label { 
            font-size: 0.72rem; 
            color: rgba(255,255,255,0.65); 
            text-transform: uppercase; 
            letter-spacing: 0.12em; 
            margin-top: 8px; 
            font-weight: 600;
        }

        /* CONTAINER */
        .container { 
            max-width: 1100px; 
            margin: 110px auto 0 auto; 
            padding: 10px 24px 70px 24px; 
            width: 100%; 
        }

        .section-header {
            font-size: 15px;
            font-weight: 800;
            color: var(--color-dark-blue);
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 24px;
            margin-bottom: 45px;
        }

        .team-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 22px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
            cursor: pointer;
        }

        .team-card:hover {
            transform: translateY(-8px) scale(1.01);
            border-color: var(--color-ocean-blue);
            box-shadow: 0 15px 30px rgba(22, 121, 171, 0.15);
        }

        .team-body { 
            display: flex; 
            align-items: center; 
            gap: 18px; 
            margin-bottom: 16px; 
        }

        .avatar-wrapper {
            position: relative;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, var(--color-ocean-blue), var(--color-cyan-mint));
            flex-shrink: 0;
        }

        .avatar-wrapper img { 
            width: 100%; 
            height: 100%; 
            border-radius: 50%; 
            object-fit: cover; 
            background-color: #f1f5f9; 
        }

        .team-info h3 { 
            margin: 0; 
            font-size: 17px; 
            font-weight: 800; 
            color: var(--color-dark-blue); 
            letter-spacing: 0.5px; 
        }

        .team-info .role-badge {
            display: inline-block;
            background: rgba(22, 121, 171, 0.1);
            color: var(--color-ocean-blue);
            font-size: 10px;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 6px;
            margin: 6px 0 8px 0;
            letter-spacing: 0.8px;
        }

        .contact-list { 
            font-size: 11px; 
            color: var(--text-muted); 
            display: flex; 
            flex-direction: column; 
            gap: 4px; 
        }

        .btn-contact {
            background-color: #f1f5f9;
            border: 1px solid var(--border-color);
            color: var(--color-dark-blue);
            font-size: 12px;
            font-weight: 700;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            text-decoration: none;
        }

        .team-card:hover .btn-contact { 
            background-color: var(--color-ocean-blue); 
            color: #ffffff; 
            border-color: var(--color-ocean-blue); 
        }

        .cta-box { 
            text-align: center; 
            margin-top: 20px; 
        }

        .btn-submit-main {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: var(--color-dark-blue);
            color: #ffffff;
            font-weight: 800;
            font-size: 15px;
            letter-spacing: 1px;
            padding: 18px 42px;
            border-radius: 16px;
            text-decoration: none;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.25);
        }

        .btn-submit-main:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 15px 30px rgba(22, 121, 171, 0.35);
            background: var(--color-ocean-blue);
        }

        footer { 
            background-color: #ffffff; 
            padding: 24px; 
            text-align: center; 
            font-size: 12px; 
            color: var(--text-muted); 
            border-top: 1px solid var(--border-color); 
            margin-top: auto; 
        }

        /* DASHBOARD GRID */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1.4fr;
            gap: 24px;
            margin-bottom: 50px;
            width: 100%;
        }
        .card-box {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 22px;
            padding: 26px;
            box-shadow: 0 10px 25px rgba(7, 65, 115, 0.05);
            width: 100%;
            box-sizing: border-box;
        }
        .card-box:hover {
            border-color: var(--color-ocean-blue);
            transform: translateY(-4px);
        }
        .chart-wrapper {
            position: relative;
            width: 210px;
            height: 210px;
            margin: 0 auto;
        }
        .chart-center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
        }
        .chart-center-text .number {
            font-size: 26px;
            font-weight: 900;
            color: var(--color-dark-blue);
            line-height: 1;
        }
        .chart-center-text .label {
            font-size: 10px;
            color: var(--text-muted);
            letter-spacing: 1px;
            margin-top: 4px;
        }

        /* TICKET LIST */
        .ticket-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .ticket-item {
            background: #f8fafc;
            border: 1px solid var(--border-color);
            padding: 14px 18px;
            border-radius: 14px;
        }
        .ticket-item:hover {
            background: #ffffff;
            transform: translateX(6px);
            border-color: var(--color-ocean-blue);
            box-shadow: 0 4px 12px rgba(7, 65, 115, 0.08);
        }
        .ticket-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }
        .ticket-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--color-dark-blue);
        }
        .badge-priority {
            background: rgba(239, 68, 68, 0.15);
            color: #dc2626;
            font-size: 9px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            letter-spacing: 0.5px;
        }
        .badge-normal {
            background: rgba(22, 121, 171, 0.15);
            color: var(--color-ocean-blue);
            font-size: 9px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 6px;
            letter-spacing: 0.5px;
        }
        .ticket-pic {
            font-size: 11px;
            color: var(--text-muted);
        }
        .progress-bar-bg {
            height: 7px;
            background-color: #e2e8f0;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 8px;
        }
        .progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--color-ocean-blue), var(--color-cyan-mint));
            border-radius: 10px;
        }

        /* MEDIA QUERIES */
        @media (max-width: 768px) {
            header { padding: 16px 20px; }
            .hero { padding: 90px 15px 140px 15px; }
            .hero-stats { flex-wrap: wrap; gap: 12px; padding: 16px 20px; }
            .stat-item { flex: 1 1 40%; padding-bottom: 12px; }
            .stat-item:not(:last-child)::after { display: none; }
            .dashboard-grid { grid-template-columns: 1fr; }
            .container { margin-top: 140px; }
        }

        /* ANIMATIONS */
        @keyframes pulseGlow {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 255, 149, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(197, 255, 149, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(197, 255, 149, 0); }
        }

        @keyframes fadeDown {
            from { opacity: 0; transform: translateY(-24px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(32px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeLeft {
            from { opacity: 0; transform: translateX(-24px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        @keyframes rotateBorder {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }

        @keyframes pulseShadow {
            0%, 100% { box-shadow: 0 10px 25px rgba(7,65,115,0.25); }
            50%      { box-shadow: 0 10px 35px rgba(93,235,215,0.45), 0 0 0 6px rgba(93,235,215,0.1); }
        }

        .hero h1        { animation: fadeDown 0.7s 0.1s ease both; }
        .hero .subtitle { animation: fadeDown 0.7s 0.25s ease both; }
        .hero p         { animation: fadeDown 0.7s 0.4s ease both; }
        .section-header { animation: fadeLeft 0.6s 0.2s ease both; }

        .anim-reveal { animation: fadeUp 0.6s ease both; animation-play-state: paused; }
        .anim-reveal.visible { animation-play-state: running; }

        .avatar-wrapper::before {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            background: conic-gradient(var(--color-cyan-mint), var(--color-lime-green), var(--color-ocean-blue), var(--color-cyan-mint));
            animation: rotateBorder 3s linear infinite;
            z-index: 0;
        }

        .avatar-wrapper img { position: relative; z-index: 1; }
        .btn-submit-main { animation: pulseShadow 2.5s ease-in-out infinite; }
        .btn-submit-main:hover { animation: none; }
    </style>
</head>
<body>

    <header>
