    <!-- SCRIPT DATA, CHARTS & ANIMATION -->
    <script>
        // PARSE DATA DARI SHEET GA
        const rawReports = <%- typeof reports !== 'undefined' ? JSON.stringify(reports) : '[]' %>;
        
        // Membalik urutan data agar data terbaru muncul paling atas
        const reversedReports = [...rawReports].reverse();

        /* =========================================================
           1. LOGIKA TABEL DENGAN PAGINASI
        ========================================================= */
        let currentPage = 1;
        const rowsPerPage = 10;

        function getStatusBadgeHTML(statusStr) {
            const st = (statusStr || '').toString().trim().toLowerCase();
            if (st.includes('selesai')) {
                return `<span class="badge-status badge-selesai">Selesai</span>`;
            } else if (st.includes('diproses') || st.includes('proses')) {
                return `<span class="badge-status badge-proses">Diproses</span>`;
            } else if (st.includes('pending')) {
                return `<span class="badge-status badge-pending">Pending</span>`;
            } else {
                return `<span class="badge-status badge-acc">Dalam Antrian</span>`;
            }
        }

        function renderTablePage(page) {
            const tbody = document.getElementById('tableReportBody');
            tbody.innerHTML = '';

            if (reversedReports.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: #64748b; padding: 20px;">Belum ada data laporan GA.</td></tr>`;
                document.getElementById('paginationInfo').innerText = `Showing 0 of 0 reports`;
                document.getElementById('prevBtn').disabled = true;
                document.getElementById('nextBtn').disabled = true;
                return;
            }

            const start = (page - 1) * rowsPerPage;
            const end = Math.min(start + rowsPerPage, reversedReports.length);
            const pageData = reversedReports.slice(start, end);

            pageData.forEach(row => {
                const tr = document.createElement('tr');
                const waktu = row.waktu || row[0] || '-';
                const unit = row.unit || row[1] || '-';
                const nama = row.nama || row[2] || '-';
                const permasalahan = row.permasalahan || row[4] || '-';
                const detail = row.detail || row[5] || '-';
                const status = row.status || row[7] || 'Dalam Antrian';

                tr.innerHTML = `
                    <td>${waktu}</td>
                    <td><b>${unit}</b></td>
                    <td>${nama}</td>
                    <td>${permasalahan}</td>
                    <td>${detail}</td>
                    <td>${getStatusBadgeHTML(status)}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('paginationInfo').innerText = `Showing ${start + 1}-${end} of ${reversedReports.length} reports`;
            document.getElementById('prevBtn').disabled = (page === 1);
            document.getElementById('nextBtn').disabled = (end >= reversedReports.length);
        }

        function changePage(direction) {
            currentPage += direction;
            renderTablePage(currentPage);
        }

        renderTablePage(currentPage);

        /* =========================================================
           2. DATA PREPARATION UNTUK CHART & LEGEND
        ========================================================= */
        const unitCounts = {};
        const dateCounts = {};
        const problemCounts = {};
        const statusCounts = {
            'Dalam Antrian': 0,
            'Diproses': 0,
            'Pending': 0,
            'Selesai': 0
        };

        rawReports.forEach(row => {
            const u = row.unit || row[1] || 'Lainnya';
            unitCounts[u] = (unitCounts[u] || 0) + 1;

            const dt = row.waktu || row[0] || 'Unknown';
            const cleanDate = dt.split(',')[0].split(' ')[0] || dt;
            dateCounts[cleanDate] = (dateCounts[cleanDate] || 0) + 1;

            const prob = row.permasalahan || row[4] || 'Lainnya';
            problemCounts[prob] = (problemCounts[prob] || 0) + 1;

            const st = (row.status || row[7] || 'Dalam Antrian').toString().trim();
            if (st.toLowerCase().includes('selesai')) statusCounts['Selesai']++;
            else if (st.toLowerCase().includes('diproses') || st.toLowerCase().includes('proses')) statusCounts['Diproses']++;
            else if (st.toLowerCase().includes('pending')) statusCounts['Pending']++;
            else statusCounts['Dalam Antrian']++;
        });

        /* =========================================================
           3. CHARTS GA (SENADA COLOR PALETTE BLUE / CYAN / LIME)
        ========================================================= */
        
        // 1. BAR CHART GA
        const ctxBar = document.getElementById('unitBarChart').getContext('2d');
        const barGrad = ctxBar.createLinearGradient(0, 0, 0, 180);
        barGrad.addColorStop(0, '#074173');
        barGrad.addColorStop(1, '#1679AB');

        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: Object.keys(unitCounts).length ? Object.keys(unitCounts) : ['SD Makasar', 'SMP', 'Daycare'],
                datasets: [{
                    label: 'Jumlah Keluhan GA',
                    data: Object.keys(unitCounts).length ? Object.values(unitCounts) : [0, 0, 0],
                    backgroundColor: barGrad,
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 11 } } },
                    y: { grid: { color: '#e2e8f0' }, ticks: { color: '#64748b', font: { size: 10 }, stepSize: 1 }, beginAtZero: true }
                }
            }
        });

        // 2. LINE CHART GA
        const ctxLine = document.getElementById('trendLineChart').getContext('2d');
        const lineGrad = ctxLine.createLinearGradient(0, 0, 0, 180);
        lineGrad.addColorStop(0, 'rgba(93, 235, 215, 0.45)');
        lineGrad.addColorStop(1, 'rgba(93, 235, 215, 0.0)');

        new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: Object.keys(dateCounts).length ? Object.keys(dateCounts) : ['Hari Ini'],
                datasets: [{
                    label: 'Tren Laporan GA',
                    data: Object.keys(dateCounts).length ? Object.values(dateCounts) : [0],
                    borderColor: '#1679AB',
                    borderWidth: 3,
                    backgroundColor: lineGrad,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#074173',
                    pointBorderColor: '#5DEBD7',
                    pointBorderWidth: 2,
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10 } } },
                    y: { grid: { color: '#e2e8f0' }, ticks: { color: '#64748b', font: { size: 10 }, stepSize: 1 }, beginAtZero: true }
                }
            }
        });

        // 3. DOUGHNUT CHART GA PROBLEM
        const problemPalette = [
  '#074173', // Navy
  '#0F5B8E', // Medium Deep Blue
  '#1679AB', // Ocean Blue
  '#2095C2', // Sky Blue
  '#32B8C6', // Teal Blue
  '#5DEBD7', // Bright Cyan / Mint
  '#89F2B4', // Soft Mint Green
  '#C5FF95', // Lime Green
  '#64748b'  // Slate Gray (untuk 'Tidak Ada Data' / Lainnya)
];
        const problemLabels = Object.keys(problemCounts).length ? Object.keys(problemCounts) : ['Tidak Ada Data'];
        const problemData = Object.keys(problemCounts).length ? Object.values(problemCounts) : [1];

        const ctxProblem = document.getElementById('problemCategoryChart').getContext('2d');
        new Chart(ctxProblem, {
            type: 'doughnut',
            data: {
                labels: problemLabels,
                datasets: [{
                    data: problemData,
                    backgroundColor: problemPalette,
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '72%',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { display: false },
                    tooltip: { enabled: true }
                }
            }
        });

        const problemLegendContainer = document.getElementById('problemChartLegend');
        problemLabels.forEach((label, idx) => {
            const color = problemPalette[idx % problemPalette.length];
            problemLegendContainer.innerHTML += `
                <div class="legend-item">
                    <span class="legend-color-box" style="background-color: ${color};"></span>
                    <span>${label}</span>
                </div>
            `;
        });

        // 4. STATUS BREAKDOWN CHART GA
        const statusColors = {
            'Dalam Antrian': '#9AA5B1', 
            'Diproses': '#ffee70',     
            'Pending': '#d03a3a',      
            'Selesai': '#2dae5e'      
        };
        const statusLabels = Object.keys(statusCounts);
        const statusData = Object.values(statusCounts);
        const statusBgColors = statusLabels.map(lbl => statusColors[lbl]);

        const ctxStatus = document.getElementById('statusBreakdownChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusData,
                    backgroundColor: statusBgColors,
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                cutout: '72%',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { display: false },
                    tooltip: { enabled: true }
                }
            }
        });

        const statusLegendContainer = document.getElementById('statusChartLegend');
        statusLabels.forEach((label) => {
            const color = statusColors[label];
            statusLegendContainer.innerHTML += `
                <div class="legend-item">
                    <span class="legend-color-box" style="background-color: ${color};"></span>
                    <span>${label}</span>
                </div>
            `;
        });

        /* =========================================================
           4. ANIMATED CANVAS HEADER & SCROLL REVEAL LOGIC
        ========================================================= */
/* ANIMASI GA: ROTATING GEARS & FLOATING PARTICLES */
const canvas = document.getElementById('ga-animation-canvas');
const ctx = canvas.getContext('2d');

function resizeCanvas() {
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
}
resizeCanvas();
window.addEventListener('resize', resizeCanvas);

// Data 3 Roda Gerigi (Gears)
const gears = [
    { x: 0.12, y: 0.25, radius: 45, teeth: 8, angle: 0, speed: 0.005, color: 'rgba(93, 235, 215, 0.25)' },
    { x: 0.88, y: 0.35, radius: 60, teeth: 12, angle: 0, speed: -0.003, color: 'rgba(197, 255, 149, 0.2)' },
    { x: 0.82, y: 0.70, radius: 35, teeth: 8, angle: 0, speed: 0.006, color: 'rgba(93, 235, 215, 0.2)' }
];

// Data Partikel Melayang (Floating Particles)
const particles = [];
for (let i = 0; i < 20; i++) {
    particles.push({
        x: Math.random(),
        y: Math.random(),
        size: Math.random() * 3 + 1,
        speedY: -(Math.random() * 0.4 + 0.1),
        opacity: Math.random() * 0.5 + 0.2
    });
}

// Fungsi Menggambar Gerigi
function drawGear(cx, cy, radius, teeth, angle, color) {
    ctx.save();
    ctx.beginPath();
    ctx.translate(cx, cy);
    ctx.rotate(angle);
    ctx.fillStyle = color;
    
    const outerRadius = radius;
    const innerRadius = radius * 0.75;
    const holeRadius = radius * 0.3;

    for (let i = 0; i < teeth; i++) {
        const alpha = (Math.PI * 2 / teeth) * i;
        const alphaNext = (Math.PI * 2 / teeth) * (i + 0.5);
        const x1 = Math.cos(alpha) * innerRadius;
        const y1 = Math.sin(alpha) * innerRadius;
        const x2 = Math.cos(alpha) * outerRadius;
        const y2 = Math.sin(alpha) * outerRadius;
        const x3 = Math.cos(alphaNext) * outerRadius;
        const y3 = Math.sin(alphaNext) * outerRadius;
        const x4 = Math.cos(alphaNext) * innerRadius;
        const y4 = Math.sin(alphaNext) * innerRadius;

        if (i === 0) ctx.moveTo(x1, y1);
        else ctx.lineTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.lineTo(x3, y3);
        ctx.lineTo(x4, y4);
    }
    ctx.closePath();
    ctx.fill();

    /* Lubang Tengah Gear */
    ctx.beginPath();
    ctx.arc(0, 0, holeRadius, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(7, 65, 115, 0.6)';
    ctx.fill();
    ctx.restore();
}

// Loop Utama Animasi Canvas
function animateGA() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    /* 1. Gambar & Putar Roda Gerigi (Gears) */
    gears.forEach(g => {
        g.angle += g.speed;
        const posX = g.x * canvas.width;
        const posY = g.y * canvas.height;
        drawGear(posX, posY, g.radius, g.teeth, g.angle, g.color);
    });

    /* 2. Gerakkan Partikel Melayang ke Atas */
    particles.forEach(p => {
        p.y += p.speedY / canvas.height;
        if (p.y < 0) {
            p.y = 1;
            p.x = Math.random();
        }
        ctx.fillStyle = `rgba(197, 255, 149, ${p.opacity})`;
        ctx.beginPath();
        ctx.arc(p.x * canvas.width, p.y * canvas.height, p.size, 0, Math.PI * 2);
        ctx.fill();
    });

    requestAnimationFrame(animateGA);
}

// Jalankan animasi
animateGA();

    </script>
</body>
