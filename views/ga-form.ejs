<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Form Request Fasilitas GA</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

<div class="hero-container">
  <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
    <div
      style="
        width: 100%;
        max-width: 580px;
        border-radius: 20px;
        overflow: hidden;
        background: var(--color-muted-blue);
        border: 1px solid var(--color-purple);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        padding: 30px;
      "
    >
      <a href="/ga" style="color: var(--text-muted); text-decoration: none; font-size: 13px; display: inline-block; margin-bottom: 15px;">
        <i class="fa-solid fa-arrow-left"></i> Kembali ke Halaman GA
      </a>

      <h2 style="color: var(--color-pink); margin-bottom: 20px; font-size: 22px">
        <i class="fa-solid fa-clipboard-list" style="margin-right: 8px"></i>Form Request Fasilitas GA
      </h2>

      <form id="gaForm">
        <!-- 1. Unit -->
        <div style="margin-bottom: 15px; text-align: left">
          <label style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 5px;">Unit / Departemen:</label>
          <select
            id="unit"
            required
            style="
              width: 100%;
              padding: 10px;
              border-radius: 8px;
              border: 1px solid var(--color-purple);
              background: var(--color-dark);
              color: white;
            "
          >
            <option value="">-- Pilih Unit --</option>
            <option value="TK">TK</option>
            <option value="SD Makasar">SD Makasar</option>
            <option value="SMP">SMP</option>
            <option value="Daycare">Daycare</option>
            <option value="Umum">Umum / Operational</option>
          </select>
        </div>

        <!-- 2. Nama Pemohon -->
        <div style="margin-bottom: 15px; text-align: left">
          <label style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 5px;">Nama Pemohon:</label>
          <input
            type="text"
            id="nama_request"
            required
            placeholder="Masukkan nama Anda"
            style="
              width: 100%;
              padding: 10px;
              border-radius: 8px;
              border: 1px solid var(--color-purple);
              background: var(--color-dark);
              color: white;
            "
          />
        </div>

        <!-- 3. Lokasi / Area -->
        <div style="margin-bottom: 15px; text-align: left">
          <label style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 5px;">Lokasi / Area Permasalahan:</label>
          <input
            type="text"
            id="lokasi"
            required
            placeholder="Contoh: Toilet Lt. 2, Ruang Guru, Lapangan"
            style="
              width: 100%;
              padding: 10px;
              border-radius: 8px;
              border: 1px solid var(--color-purple);
              background: var(--color-dark);
              color: white;
            "
          />
        </div>

        <!-- 4. Jenis Masalah GA -->
        <div style="margin-bottom: 15px; text-align: left">
          <label style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 5px;">Jenis Fasilitas / Keluhan:</label>
          <select
            id="permasalahan"
            required
            style="
              width: 100%;
              padding: 10px;
              border-radius: 8px;
              border: 1px solid var(--color-purple);
              background: var(--color-dark);
              color: white;
            "
          >
            <option value="">-- Pilih Masalah --</option>
            <option value="AC / Kipas Angin">AC / Kipas Angin</option>
            <option value="Lampu / Kelistrikan">Lampu / Kelistrikan</option>
            <option value="Plambing / Air / Toilet">Plambing / Air / Toilet</option>
            <option value="Meja / Kursi / Meubel">Meja / Kursi / Meubel</option>
            <option value="Kebersihan Area">Kebersihan Area</option>
            <option value="Lainnya">Lainnya</option>
          </select>
        </div>

        <!-- 5. Detail Permasalahan -->
        <div style="margin-bottom: 15px; text-align: left">
          <label style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 5px;">Detail Request / Keluhan:</label>
          <textarea
            id="detail_permasalahan"
            rows="3"
            required
            placeholder="Jelaskan detail barang atau perbaikan yang dibutuhkan..."
            style="
              width: 100%;
              padding: 10px;
              border-radius: 8px;
              border: 1px solid var(--color-purple);
              background: var(--color-dark);
              color: white;
            "
          ></textarea>
        </div>

        <!-- 6. Upload Foto -->
        <div style="margin-bottom: 20px; text-align: left">
          <label style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 5px;">Upload Foto Kerusakan (Opsional):</label>
          <input type="file" id="fotoInput" accept="image/*" style="width: 100%; color: white;" />
          <img id="imgPreview" style="max-width: 100%; height: auto; margin-top: 10px; display: none; border-radius: 8px; border: 1px solid var(--color-purple);" />
        </div>

        <button
          type="submit"
          id="btnSubmit"
          class="btn-pink"
          style="width: 100%; justify-content: center"
        >
          Kirim Request GA
        </button>
      </form>

      <p id="gaStatusMessage" style="margin-top: 15px; font-size: 13px; text-align: center"></p>
    </div>
  </div>
</div>

<script>
  let base64Foto = "";
  let mimeTypeFoto = "";

  document.getElementById('fotoInput').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
      mimeTypeFoto = file.type;
      const reader = new FileReader();
      reader.onload = function(evt) {
        base64Foto = evt.target.result;
        const preview = document.getElementById('imgPreview');
        preview.src = base64Foto;
        preview.style.display = 'block';
      };
      reader.readAsDataURL(file);
    }
  });

  document.getElementById('gaForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const status = document.getElementById("gaStatusMessage");
    const btn = document.getElementById("btnSubmit");

    btn.disabled = true;
    status.style.color = "var(--color-pink)";
    status.innerText = "Mengirim data...";

    const payload = {
      unit: document.getElementById('unit').value,
      nama_request: document.getElementById('nama_request').value,
      lokasi: document.getElementById('lokasi').value,
      permasalahan: document.getElementById('permasalahan').value,
      detail_permasalahan: document.getElementById('detail_permasalahan').value,
      fotoBase64: base64Foto,
      fotoMimeType: mimeTypeFoto
    };

    try {
      const response = await fetch('/ga/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();
      if (result.status === 'success') {
        window.location.href = result.redirectUrl;
      } else {
        status.style.color = "#f87171";
        status.innerText = "Gagal mengirim data. Coba lagi.";
        btn.disabled = false;
      }
    } catch (err) {
      status.style.color = "#f87171";
      status.innerText = "Terjadi kesalahan koneksi server.";
      btn.disabled = false;
    }
  });
</script>

</body>
</html>